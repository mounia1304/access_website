---
// Homepage: same blocks, in the same order, as the current access-transit.com homepage, except
// its testimonials, which the client had removed (2026-10-26).
// Under the second screen, a trail of chevrons (decoration) runs in the gaps between them,
// coming from the left and from the right in turn on its way down the page.
import Base from '../layouts/Base.astro';
import ChevronTrail from '../components/ChevronTrail.astro';
import Hero from '../components/Hero.astro';
import About from '../components/About.astro';
import Services from '../components/Services.astro';
import Why from '../components/Why.astro';
import BigNumber from '../components/BigNumber.astro';
import References from '../components/References.astro';
import Partners from '../components/Partners.astro';
import EServices from '../components/EServices.astro';
import Contact from '../components/Contact.astro';
import LocationMap from '../components/LocationMap.astro';
---

<Base>
	<Hero />
	<About />
	<ChevronTrail from="left" />
	<Services />
	<ChevronTrail from="right" />
	<Why />
	<ChevronTrail from="left" />
	<BigNumber />
	<ChevronTrail from="right" />
	<References />
	<Partners />
	<ChevronTrail from="left" />
	<EServices />
	<ChevronTrail from="right" />
	<Contact />
	<LocationMap />
</Base>
