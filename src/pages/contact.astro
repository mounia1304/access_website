---
// Contact: the team, drawn as the director's diagram (TeamDiagram.astro), then the contact block
// of the homepage (phone, addresses and form), then the map of the current site's homepage (the
// current contact page has a map too, but it points to another country: the homepage's, which
// shows the company, is used instead).
//
// The team was first a grid of cards with the current site's six people; the director then
// asked for the page to look exactly like a diagram of their own, with the team they listed:
// the cards and the people who are not in it are gone.
import Contact from '../components/Contact.astro';
import LocationMap from '../components/LocationMap.astro';
import PageHead from '../components/PageHead.astro';
import TeamDiagram from '../components/TeamDiagram.astro';
import Base from '../layouts/Base.astro';
import { site } from '../data/site';
import { useTranslations } from '../i18n';

const t = useTranslations();
const { contact } = t.pages;
---

<Base title={`${contact.title} | ${site.name}`}>
	<PageHead title={contact.title} />

	<section class="section page-body team-section">
		<div class="wrap">
			<div class="wrap__in">
				<h2 class="team-section__title">{contact.team}</h2>
				<TeamDiagram />
			</div>
		</div>
	</section>

	<Contact wide />
	<LocationMap wide />
</Base>

<style>
	.team-section {
		padding-bottom: 0;
	}

	.team-section__title {
		margin-bottom: clamp(1.5rem, 1rem + 2vw, 2.5rem);
		font-size: var(--fs-quote);
		font-weight: 700;
		letter-spacing: -0.02em;
		text-align: center;
	}
</style>
