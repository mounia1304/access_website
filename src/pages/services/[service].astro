---
// The page of a service: its photo across the block, its text under it, as on the current site,
// then the three commitments. There is no side column: the client had its contents removed one
// after the other (2026-10-22: the four trades, the documents, then the card that offers help),
// then asked for the room it left to be used. So the photo runs the block's whole width, and on
// large screens the text runs in two columns (`.prose-pair`).
import { Image } from 'astro:assets';
import Assurances from '../../components/Assurances.astro';
import PageHead from '../../components/PageHead.astro';
import Prose from '../../components/Prose.astro';
import Base from '../../layouts/Base.astro';
import photoAerien from '../../assets/photos/services/aerien.jpg';
import photoDouane from '../../assets/photos/services/douane.webp';
import photoMaritime from '../../assets/photos/services/maritime.jpg';
import photoRoutier from '../../assets/photos/services/routier.webp';
import { site } from '../../data/site';
import { route, useTranslations } from '../../i18n';
import type { Block } from '../../i18n/fr.pages';
import { excerpt } from '../../utils/text';

// The last part of each service's address is its page here.
export function getStaticPaths() {
	return (['douane', 'routier', 'aerien', 'maritime'] as const).map((key) => ({
		params: { service: route(key).split('/').filter(Boolean).at(-1) },
		props: { key },
	}));
}

interface Props {
	key: 'douane' | 'routier' | 'aerien' | 'maritime';
}

// The photographs supplied by the client (October 2026), as they came. The client asked for their
// quality to be kept: they are offered up to their full width, at a high quality setting.
const photos = { douane: photoDouane, routier: photoRoutier, aerien: photoAerien, maritime: photoMaritime };

const { key } = Astro.props;
const t = useTranslations();
const page = t.pages.services[key];
const first = page.blocks.find((block) => 'p' in block);

// The two columns. The text is cut between two of its blocks (never inside a paragraph or a
// list), where the columns come out closest in length, and never just after a sentence that
// ends with a colon: it introduces the block under it. Lengths are counted in lines of about
// 70 characters; each item of a list takes one line at least.
const lines = (text: string) => Math.ceil(text.length / 70);
const length = (block: Block) =>
	'p' in block
		? lines(block.p)
		: 'list' in block
			? block.list.reduce((sum, item) => sum + lines(item), 0)
			: block.terms.reduce((sum, item) => sum + 1 + lines(item.text), 0);
const total = page.blocks.reduce((sum, block) => sum + length(block), 0);
let cut = page.blocks.length;
let best = Infinity;
let before = 0;
page.blocks.forEach((block, index) => {
	before += length(block);
	const last = index === page.blocks.length - 1;
	const introduces = 'p' in block && block.p.trimEnd().endsWith(':');
	if (last || introduces || Math.abs(total - 2 * before) >= best) return;
	best = Math.abs(total - 2 * before);
	cut = index + 1;
});
const columns = [page.blocks.slice(0, cut), page.blocks.slice(cut)].filter((blocks) => blocks.length > 0);
---

<Base title={`${page.title.join(' ')} | ${site.name}`} description={first && 'p' in first ? excerpt(first.p) : undefined}>
	<PageHead title={page.title} trail={[{ label: t.pages.ui.services }]} />

	<section class="section page-body">
		<div class="wrap">
			<div class="wrap__in service">
				<Image
					class="service__photo"
					src={photos[key]}
					alt=""
					widths={[640, 960, 1280, 1600, photos[key].width]}
					sizes="(min-width: 120.0625em) 1720px, (min-width: 80em) 90vw, 100vw"
					quality={90}
					loading="eager"
				/>
				<div class="prose-pair">
					{columns.map((blocks) => <Prose blocks={blocks} />)}
				</div>
			</div>
		</div>
	</section>

	<Assurances />
</Base>

<style>
	.service {
		display: grid;
		gap: clamp(1.75rem, 1.25rem + 2vw, 3rem);
	}

	.service :global(.service__photo) {
		width: 100%;
		aspect-ratio: 16 / 8;
		border-radius: var(--r-lg);
		object-fit: cover;
	}
</style>
