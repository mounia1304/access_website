---
// The blog. Its first page opens on the article "À la une", across the width (its picture beside
// its text). A panel "Access Transit en bref" stood beside it (who the company is, its certificate,
// its figures, the ways to reach it); the client asked for it to be removed (2026-10-22). Then come
// the categories and the other articles, newest first, PAGE_SIZE to a page (/blog/2/, /blog/3/…).
//
// The articles are Markdown files in src/content/blog/ (README.md, "Writing an article").
import type { GetStaticPaths, Page } from 'astro';
import BlogCard from '../../components/BlogCard.astro';
import BlogPager from '../../components/BlogPager.astro';
import CategoryNav from '../../components/CategoryNav.astro';
import HelpBand from '../../components/HelpBand.astro';
import PageHead from '../../components/PageHead.astro';
import Base from '../../layouts/Base.astro';
import { PAGE_SIZE } from '../../data/blog';
import { site } from '../../data/site';
import { route, useTranslations } from '../../i18n';
import { featuredOf, getPosts, type Post } from '../../utils/blog';

export const getStaticPaths = (async ({ paginate }) => {
	const posts = await getPosts();
	const featured = featuredOf(posts);
	return paginate(
		posts.filter((post) => post !== featured),
		{ pageSize: PAGE_SIZE, props: { posts, featured } },
	);
}) satisfies GetStaticPaths;

interface Props {
	page: Page<Post>;
	posts: Post[];
	featured?: Post;
}

const { page, posts, featured } = Astro.props;
const first = page.currentPage === 1;
const t = useTranslations();
const { blog } = t.pages;
const title = first ? `Blog | ${site.name}` : `Blog – ${blog.page} ${page.currentPage} | ${site.name}`;
---

<Base title={title} description={blog.intro}>
	<PageHead title={blog.title} trail={first ? [] : [{ label: 'Blog', href: route('blog') }]}>
		<p class="lead blog-intro">{blog.intro}</p>
	</PageHead>

	{
		first && featured && (
			<section class="section page-body blog-featured">
				<div class="wrap">
					<div class="wrap__in">
						<div class="blog-top__lead">
							<p class="eyebrow eyebrow--lines">{blog.featured}</p>
							<BlogCard post={featured} featured heading="h2" eager />
						</div>
					</div>
				</div>
			</section>
		)
	}

	<section class:list={['section', 'blog-list', { 'page-body': !first || !featured }]}>
		<div class="wrap">
			<div class="wrap__in">
				<div class="blog-list__head">
					<h2>{blog.all}</h2>
					<CategoryNav posts={posts} current="all" />
				</div>
				{
					page.data.length ? (
						<ul class="post-grid">
							{page.data.map((post) => (
								<li>
									<BlogCard post={post} />
								</li>
							))}
						</ul>
					) : (
						<p class="blog-list__note">{blog.soon}</p>
					)
				}
				<BlogPager page={page} />
			</div>
		</div>
	</section>

	<HelpBand />
</Base>

<style>
	.blog-featured {
		padding-bottom: 0;
	}

	.blog-intro {
		max-width: 40rem;
		margin-top: 0.5rem;
	}

	/* "À la une": its label, then the article (BlogCard.astro sets it across the width). */
	.blog-top__lead {
		display: grid;
		align-content: start;
		gap: 1.25rem;
	}

	/* All the articles. */
	.blog-list {
		padding-top: clamp(2.5rem, 1.5rem + 3vw, 4.5rem);
	}

	.blog-list.page-body {
		padding-top: 0;
	}

	.blog-list__head {
		display: grid;
		gap: 1.25rem;
		margin-bottom: clamp(2rem, 1.5rem + 1.5vw, 3rem);
		padding-bottom: 1.5rem;
		border-bottom: 1px solid var(--c-line);
	}

	.blog-list__head h2 {
		font-size: clamp(1.625rem, 1.3rem + 1vw, 2.25rem);
		font-weight: 700;
		letter-spacing: -0.025em;
	}

	.blog-list__note {
		color: var(--c-text);
	}

</style>
