---
// The blog: its articles, most recent first (one so far, as on the current site).
import Icon from '../../components/Icon.astro';
import PageHead from '../../components/PageHead.astro';
import Base from '../../layouts/Base.astro';
import { site } from '../../data/site';
import { useTranslations } from '../../i18n';
import { excerpt } from '../../utils/text';

const t = useTranslations();
const { blog } = t.pages;
---

<Base title={`${blog.title} | ${site.name}`}>
	<PageHead title={blog.title} />

	<section class="section page-body">
		<div class="wrap">
			<ul class="wrap__in posts">
				{
					blog.posts.map((post) => (
						<li class="card post reveal">
							<p class="post__meta">
								<span class="chip">{post.category}</span>
								<time datetime={post.date}>{post.dateText}</time>
							</p>
							<h2>
								<a class="card__link" href={`/${post.slug}/`}>
									{post.title}
								</a>
							</h2>
							<p>{excerpt(post.paragraphs[0], 240)}</p>
							<span class="post__more" aria-hidden="true">
								{blog.readMore}
								<span class="disc">
									<Icon name="arrow-right" size={14} />
								</span>
							</span>
						</li>
					))
				}
			</ul>
		</div>
	</section>
</Base>

<style>
	.posts {
		display: grid;
		gap: 1.25rem;
	}

	.post {
		display: grid;
		gap: 1rem;
		max-width: 58rem;
		padding: clamp(1.5rem, 1rem + 2.5vw, 2.75rem);
	}

	.post__meta {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 0.75rem 1rem;
		font-size: var(--fs-small);
	}

	.post h2 {
		font-size: clamp(1.375rem, 1.1rem + 1.2vw, 1.875rem);
		font-weight: 700;
		letter-spacing: -0.02em;
		line-height: 1.25;
	}

	.post__more {
		display: inline-flex;
		align-items: center;
		gap: 0.75rem;
		color: var(--c-label);
		font-size: var(--fs-ui);
		font-weight: 600;
	}
</style>
