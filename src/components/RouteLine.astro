---
// The route line: a thin line that crosses the page in the gap between two sections, runs
// along one side of a section with rounded corners, and carries two small dashes that glide
// along it without stopping, like goods on a route. It is our own drawing of the idea, and
// it is decoration only (hidden from screen readers, never in the way of a click).
//
// The drawing is wider than any screen and centred on the page, so its vertical run always
// sits in the margin, just outside the text column. Screens narrower than 82em have no room
// for that margin: there, only the part that crosses the page is shown.
//
// Two shapes, chosen with `anchor`:
// - 'top' (default): the line crosses the page where the component is placed, then turns
//   down the side given by `side` and leaves. Use from="left" side="right", or the mirror.
// - 'bottom': the line arrives in the side margin above the component, runs down, then
//   crosses the page where the component is placed. Use from="right" side="right", or the mirror.
interface Props {
	/** Edge of the screen the dashes come from. */
	from?: 'left' | 'right';
	/** Margin in which the line runs vertically. */
	side?: 'left' | 'right';
	/** Whether the drawing hangs below the component ('top') or stands above it ('bottom'). */
	anchor?: 'top' | 'bottom';
	/** Length of the vertical run, in px. */
	drop?: number;
}

const { from = 'left', side = 'right', anchor = 'top', drop = 220 } = Astro.props;

const WIDTH = 3840;
const EDGE = 646; // from the middle of the page to the vertical run: 38px outside the 76rem column
const RADIUS = 20;
const DASH = 28;
const SPEED = 100; // px per second, the same as the logo conveyor (Marquee.astro)
const top = 2;

const r = RADIUS;
const bottom = top + drop;
const x = WIDTH / 2 + (side === 'left' ? -EDGE : EDGE);
const d = from === 'left' ? 1 : -1;
const [start, end] = d > 0 ? [0, WIDTH] : [WIDTH, 0];

// Drawn in the direction the dashes travel: across, round a corner, down, round a corner, across.
const path = [
	`M${start} ${top}H${x - d * r}`,
	`a${r} ${r} 0 0 ${d > 0 ? 1 : 0} ${d * r} ${r}`,
	`V${bottom - r}`,
	`a${r} ${r} 0 0 ${d > 0 ? 0 : 1} ${d * r} ${r}`,
	`H${end}`,
].join('');
const length = WIDTH - 2 * r + (drop - 2 * r) + Math.PI * r;

// Two dashes on the line, half its length apart: the pattern repeats every half length,
// so moving it by that much brings it back to where it started.
const period = length / 2;
const height = drop + 2 * top;
const style = [
	`--route-h: ${height}px`,
	`--route-period: ${period.toFixed(1)}px`,
	`--route-time: ${(period / SPEED).toFixed(1)}s`,
].join('; ');
---

<div class:list={['route', `route--${anchor}`]} aria-hidden="true">
	<div class="route__view" style={style} data-route>
		<svg class="route__svg" width={WIDTH} height={height} viewBox={`0 0 ${WIDTH} ${height}`} fill="none" focusable="false">
			<path class="route__line" d={path}></path>
			<path class="route__dash" d={path} stroke-dasharray={`${DASH} ${(period - DASH).toFixed(1)}`}></path>
		</svg>
	</div>
</div>

<script>
	// The dashes only move while their line is on screen.
	const routes = document.querySelectorAll<HTMLElement>('[data-route]');
	if (routes.length && 'IntersectionObserver' in window) {
		const observer = new IntersectionObserver(
			(entries) => {
				for (const entry of entries) entry.target.toggleAttribute('data-live', entry.isIntersecting);
			},
			{ rootMargin: '120px 0px' },
		);
		routes.forEach((route) => observer.observe(route));
	}
</script>

<style>
	/* Takes no room in the page: the drawing hangs below this point, or stands above it. */
	.route {
		position: relative;
		z-index: 1;
		height: 0;
		pointer-events: none;
	}

	.route__view {
		position: absolute;
		inset: 0 0 auto;
		height: var(--route-h);
		overflow: hidden;
		/* Fainter towards the edges of the screen. */
		-webkit-mask-image: linear-gradient(90deg, rgb(0 0 0 / 0.45), #000 50%, rgb(0 0 0 / 0.45));
		mask-image: linear-gradient(90deg, rgb(0 0 0 / 0.45), #000 50%, rgb(0 0 0 / 0.45));
	}

	.route--bottom .route__view {
		inset: auto 0 0;
	}

	.route__svg {
		position: absolute;
		top: 0;
		left: 50%;
		max-width: none;
		margin-left: -1920px;
	}

	.route--bottom .route__svg {
		top: auto;
		bottom: 0;
	}

	/* No side margin to run in: keep only the crossing line (the view is cut to its height). */
	@media (max-width: 81.99em) {
		.route__view {
			height: 4px;
		}
	}

	.route__line,
	.route__dash {
		stroke-width: 3;
	}

	.route__line {
		stroke: var(--c-route);
	}

	.route__dash {
		stroke: var(--c-route-mark);
		stroke-linecap: round;
		animation: route-travel var(--route-time) linear infinite paused;
	}

	.route__view[data-live] .route__dash {
		animation-play-state: running;
	}

	:global([data-motion='paused']) .route__view .route__dash {
		animation-play-state: paused;
	}

	@keyframes route-travel {
		from {
			stroke-dashoffset: var(--route-period);
		}

		to {
			stroke-dashoffset: 0;
		}
	}

	/* Visitors who asked their system for less movement get the line with still dashes. */
	@media (prefers-reduced-motion: reduce) {
		.route__dash {
			animation: none;
		}
	}
</style>
