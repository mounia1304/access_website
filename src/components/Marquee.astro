---
// A strip that glides sideways without end, at the speed of the lights of the chevron trail.
// The content is written once and repeated here so the loop has no seam; the repeats are
// hidden from screen readers. The strip stops while it is pointed at, when the visitor
// presses a pause button (MotionToggle.astro), and for visitors who asked for less movement:
// they get everything at once, centred, on as many lines as needed.
interface Props {
	/** Pixels per second. */
	speed?: number;
	class?: string;
}

const { speed = 100, class: className } = Astro.props;
const content = await Astro.slots.render('default');
---

<div class:list={['marquee', className]} data-marquee data-speed={speed}>
	<div class="marquee__track">
		<div class="marquee__set" set:html={content} />
		<div class="marquee__set" aria-hidden="true" set:html={content} />
		<div class="marquee__set" aria-hidden="true" set:html={content} />
	</div>
</div>

<script>
	// One trip lasts as long as the strip is wide, so the speed is the same on every screen.
	for (const marquee of document.querySelectorAll<HTMLElement>('[data-marquee]')) {
		const set = marquee.querySelector<HTMLElement>('.marquee__set');
		if (!set) continue;
		const speed = Number(marquee.dataset.speed) || 100;
		const update = () => {
			if (set.offsetWidth) marquee.style.setProperty('--marquee-time', `${(set.offsetWidth / speed).toFixed(1)}s`);
		};
		update();
		if ('ResizeObserver' in window) new ResizeObserver(update).observe(set);
	}
</script>

<style>
	.marquee {
		overflow: hidden;
		/* Fades out at both edges of the screen. */
		-webkit-mask-image: linear-gradient(90deg, transparent, #000 9%, #000 91%, transparent);
		mask-image: linear-gradient(90deg, transparent, #000 9%, #000 91%, transparent);
	}

	.marquee__track {
		display: flex;
		width: max-content;
		animation: marquee-glide var(--marquee-time, 36s) linear infinite;
	}

	.marquee__set {
		flex: none;
	}

	.marquee:hover .marquee__track,
	:global([data-motion='paused']) .marquee__track {
		animation-play-state: paused;
	}

	@keyframes marquee-glide {
		to {
			transform: translateX(calc(-100% / 3));
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.marquee {
			-webkit-mask-image: none;
			mask-image: none;
		}

		.marquee__track {
			width: auto;
			animation: none;
		}

		.marquee__set {
			flex: 1;
		}

		.marquee__set[aria-hidden='true'] {
			display: none;
		}
	}
</style>
