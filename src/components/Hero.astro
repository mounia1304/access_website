---
// First screen, built after the client's mockup (reference/maquette-premier-ecran-2.webp):
// the message on the left, the picture on the right in a slanted frame with slanted bars
// and a handwritten slogan, and under them a panel whose five cards choose the message.
//
// It is still the slider of the current site: five messages, no auto-play; visitors pick one
// with the cards, the arrows, the keyboard or a swipe. The picture is the same for all five.
//
// THE PICTURE is the cut-out supplied by the client (photos/hero/transport.webp, transparent
// background). The sky behind it (photos/hero/ciel.jpg) is generated by
// scripts/make-hero-sky.mjs. The ship's bow and the crane are allowed to stick out of the
// frame on the right, as in the mockup.
import { Image } from 'astro:assets';
import Icon from './Icon.astro';
import subject from '../assets/photos/hero/transport.webp';
import sky from '../assets/photos/hero/ciel.jpg';
import { roundedShape } from './shapes';
import { route, useTranslations } from '../i18n';

const t = useTranslations();
const { hero } = t;

const slides = hero.slides.map((slide, index) => ({
	...slide,
	slideId: `hero-slide-${index + 1}`,
	tabId: `hero-tab-${index + 1}`,
	first: index === 0,
}));

// The frame, measured on the mockup (in px, for a box of 636 x 421): its left side follows the
// logo's slant, its right side is steeper. The sky is cut to this shape.
const BOX = { width: 636, height: 421 };
const frameShape = roundedShape(
	[
		[320, 0],
		[636, 0],
		[492, 421],
		[0, 421],
	],
	[34, 40, 34, 30],
	BOX.width,
	BOX.height,
);
// The picture is cut by the same left side and the same bottom, but left free on the right.
const subjectShape = roundedShape(
	[
		[320, 0],
		[800, 0],
		[800, 421],
		[0, 421],
	],
	[34, 0, 0, 30],
	BOX.width,
	BOX.height,
);
---

<section class="hero" aria-roledescription="carrousel" aria-label={hero.label} data-hero>
	<h1 class="visually-hidden">{hero.h1}</h1>
	<div class="hero__decor" aria-hidden="true"></div>

	<svg class="hero__defs" width="0" height="0" aria-hidden="true" focusable="false">
		<defs>
			<clipPath id="hero-frame" clipPathUnits="objectBoundingBox"><path d={frameShape}></path></clipPath>
			<clipPath id="hero-subject" clipPathUnits="objectBoundingBox"><path d={subjectShape}></path></clipPath>
		</defs>
	</svg>

	<div class="hero__wrap">
		<div class="hero__main">
			<div class="hero__text">
				<p class="chip">{hero.tagline}</p>
				<div class="hero__slides">
					{
						slides.map((slide) => (
							<div
								class="hero__slide"
								id={slide.slideId}
								role="tabpanel"
								aria-labelledby={slide.tabId}
								data-slide
								data-current={slide.first ? '' : undefined}
								inert={!slide.first}
							>
								<h2 class="hero__title">
									{slide.title} <span class="mark">{slide.mark}</span>
								</h2>
								<p class="hero__lead">{slide.text}</p>
								<a class="btn btn--accent hero__cta" href={route(slide.key)}>
									{slide.cta}
									<Icon name="arrow-right" size={16} />
								</a>
							</div>
						))
					}
				</div>
			</div>

			<div class="hero__visual">
				<div class="hero__stage">
					<span class="hero__shape hero__shape--left" aria-hidden="true"></span>
					<span class="hero__shape hero__shape--pale" aria-hidden="true"></span>
					<span class="hero__shape hero__shape--strong" aria-hidden="true"></span>
					<div class="hero__frame">
						<div class="hero__sky">
							<Image src={sky} alt="" widths={[640, 1280, sky.width]} sizes="(min-width: 64em) 42vw, 94vw" quality={72} priority />
						</div>
						<div class="hero__subject">
							<Image
								src={subject}
								alt={hero.imageAlt}
								widths={[640, 1100, subject.width]}
								sizes="(min-width: 64em) 43vw, 96vw"
								quality={82}
								priority
							/>
						</div>
					</div>
					<p class="hero__slogan">
						<span>{hero.slogan[0]}</span>
						<span>{hero.slogan[1]}</span>
						<svg viewBox="0 0 80 14" aria-hidden="true" focusable="false">
							<path d="M2 11C26 6 52 3 78 2.5"></path>
						</svg>
					</p>
				</div>
			</div>
		</div>

		<div class="hero__panel">
			<div class="hero__intro">
				<p class="eyebrow">{hero.panel.eyebrow}</p>
				<p class="hero__panel-title">
					{hero.panel.title[0]}<br />{hero.panel.title[1]}
				</p>
				<p class="hero__panel-text">{hero.panel.text}</p>
			</div>

			<div class="hero__tabs" role="tablist" aria-label={hero.tablist} data-tabs>
				{
					slides.map((slide) => (
						<button
							class="hero__tab"
							type="button"
							role="tab"
							id={slide.tabId}
							aria-controls={slide.slideId}
							aria-selected={slide.first ? 'true' : 'false'}
							tabindex={slide.first ? 0 : -1}
							data-tab
						>
							<span class="icon-tile">
								<Icon name={slide.icon} size={28} />
							</span>
							<span class="hero__tab-label">
								{slide.title} {slide.mark}
							</span>
							<span class="disc" aria-hidden="true">
								<Icon name="arrow-right" size={14} />
							</span>
						</button>
					))
				}
			</div>

			<div class="hero__arrows">
				<button class="circle" type="button" aria-label={hero.prev} data-prev>
					<Icon name="arrow-left" size={18} />
				</button>
				<button class="circle" type="button" aria-label={hero.next} data-next>
					<Icon name="arrow-right" size={18} />
				</button>
			</div>
		</div>
	</div>
</section>

<script>
	for (const root of document.querySelectorAll<HTMLElement>('[data-hero]')) {
		const slides = [...root.querySelectorAll<HTMLElement>('[data-slide]')];
		const tabs = [...root.querySelectorAll<HTMLButtonElement>('[data-tab]')];
		const strip = root.querySelector<HTMLElement>('[data-tabs]');
		let current = 0;

		const show = (index: number, focusTab = false) => {
			current = (index + slides.length) % slides.length;
			slides.forEach((slide, i) => {
				slide.toggleAttribute('data-current', i === current);
				slide.inert = i !== current;
			});
			tabs.forEach((tab, i) => {
				tab.setAttribute('aria-selected', String(i === current));
				tab.tabIndex = i === current ? 0 : -1;
			});
			if (focusTab) tabs[current].focus({ preventScroll: true });
			// On small screens the cards sit in a strip that scrolls sideways: bring the chosen
			// one into view there, without moving the page itself.
			if (strip && strip.scrollWidth > strip.clientWidth) {
				const tab = tabs[current];
				const left = tab.offsetLeft - (strip.clientWidth - tab.offsetWidth) / 2;
				strip.scrollTo({ left, behavior: 'smooth' });
			}
		};

		tabs.forEach((tab, index) => {
			tab.addEventListener('click', () => show(index));
			tab.addEventListener('keydown', (event) => {
				let target: number;
				if (event.key === 'ArrowRight') target = current + 1;
				else if (event.key === 'ArrowLeft') target = current - 1;
				else if (event.key === 'Home') target = 0;
				else if (event.key === 'End') target = slides.length - 1;
				else return;
				event.preventDefault();
				show(target, true);
			});
		});

		root.querySelector('[data-prev]')?.addEventListener('click', () => show(current - 1));
		root.querySelector('[data-next]')?.addEventListener('click', () => show(current + 1));

		// Swipe left or right on the message or the picture, on touch screens.
		const swipeArea = root.querySelector<HTMLElement>('.hero__main');
		let startX = 0;
		let startY = 0;
		swipeArea?.addEventListener(
			'touchstart',
			(event) => {
				startX = event.touches[0].clientX;
				startY = event.touches[0].clientY;
			},
			{ passive: true },
		);
		swipeArea?.addEventListener(
			'touchend',
			(event) => {
				const dx = event.changedTouches[0].clientX - startX;
				const dy = event.changedTouches[0].clientY - startY;
				if (Math.abs(dx) > 48 && Math.abs(dx) > Math.abs(dy) * 1.5) show(current + (dx < 0 ? 1 : -1));
			},
			{ passive: true },
		);
	}
</script>

<style>
	/*
	 * With the top bar and the menu above it, the hero ends exactly at the bottom of the first
	 * screen on large screens: the panel of cards takes the room it needs, the message and the
	 * picture share what is left. All measures come from the mockup (1785 x 881).
	 */
	.hero {
		--head: calc(var(--topbar-h) + var(--header-h-top));
		--foot: clamp(1.5rem, 7.25svh, 4rem); /* room left under the panel */
		position: relative;
		isolation: isolate;
		padding-bottom: var(--foot);
	}

	.hero__defs {
		position: absolute;
	}

	/* A large pale shape rising in the bottom right corner of the screen. It fades out in the
	   room left under the panel, so it has no hard lower edge and the second screen starts clear. */
	.hero__decor {
		display: none;
		position: absolute;
		inset: 0;
		z-index: -1;
		pointer-events: none;
		-webkit-mask-image: linear-gradient(to top, transparent, #000 var(--foot));
		mask-image: linear-gradient(to top, transparent, #000 var(--foot));
	}

	.hero__decor::before {
		content: '';
		position: absolute;
		right: 0;
		bottom: 0;
		width: max(29%, 16rem);
		height: 51%;
		background: linear-gradient(96deg, var(--c-wave), color-mix(in srgb, var(--c-wave) 35%, transparent));
		clip-path: polygon(0 100%, 53.4% 28.3%, 76% 13%, 100% 1%, 100% 100%);
	}

	.hero__wrap {
		width: min(100% - 2 * var(--gutter-hero), var(--container-hero));
		margin-inline: auto;
	}

	/* ── Message ────────────────────────────────────────── */
	.hero__main {
		display: grid;
		gap: 1.75rem;
		padding-block: 1.75rem 2rem;
		/* Sideways swipes change the message; without this, some browsers treat them as "go back". */
		touch-action: pan-y pinch-zoom;
	}

	/* All messages share one grid cell, so the block keeps the height of the longest one. */
	.hero__slides {
		display: grid;
		grid-template-columns: minmax(0, 1fr);
		margin-top: 1rem;
	}

	.hero__slide {
		grid-area: 1 / 1;
		display: flex;
		flex-direction: column;
		align-items: flex-start;
		opacity: 0;
		visibility: hidden;
		transform: translateY(0.5rem);
		transition:
			opacity 0.3s,
			transform 0.5s var(--ease),
			visibility 0.3s;
	}

	.hero__slide[data-current] {
		opacity: 1;
		visibility: visible;
		transform: none;
		transition-delay: 0.12s;
	}

	/* Two lines: the first navy, the second in the lighter indigo. */
	.hero__title {
		font-size: var(--fs-hero);
		font-weight: 550;
		letter-spacing: -0.025em;
		line-height: 1;
	}

	.hero__title .mark {
		display: block;
	}

	.hero__lead {
		max-width: 27.5em;
		margin-block: 1.4375rem 1.3125rem;
		font-size: clamp(1rem, 0.9rem + 0.25vw, 1.0625rem);
		line-height: 1.42;
		text-wrap: balance;
	}

	.hero__cta {
		min-height: 2.875rem;
		padding-inline: 1.65rem;
	}

	/* ── Picture ────────────────────────────────────────── */

	/* The stage holds the frame, the three slanted bars and the slogan, all placed in
	   percentages of its box, so the whole composition scales as one. */
	.hero__visual {
		container-type: inline-size;
	}

	.hero__stage {
		position: relative;
		container-type: inline-size;
		width: 100%;
		aspect-ratio: 636 / 446;
	}

	.hero__frame {
		position: absolute;
		inset: 0;
	}

	.hero__sky,
	.hero__subject {
		position: absolute;
		inset: 0;
		clip-path: url(#hero-frame);
	}

	.hero__sky :global(img) {
		width: 100%;
		height: 100%;
		object-fit: cover;
	}

	.hero__subject :global(img) {
		position: absolute;
		top: 3.6%;
		left: 0.5%;
		width: 101%;
		max-width: none;
	}

	/* Slanted bars with round ends, in the slant of the logo. */
	.hero__shape {
		display: none;
		position: absolute;
		border-radius: 4.2cqw;
		transform: skewX(var(--slant));
		transform-origin: bottom left;
	}

	.hero__shape--left {
		top: 16.4%;
		left: 0;
		width: 8.47%;
		height: 49.2%;
		background: linear-gradient(to bottom, var(--c-shape) 45%, color-mix(in srgb, var(--c-shape) 50%, transparent));
	}

	.hero__shape--pale {
		top: 45.4%;
		left: 57.5%;
		width: 5.8%;
		height: 54.6%;
		border-radius: 2.9cqw;
		background: linear-gradient(to bottom, var(--c-shape), color-mix(in srgb, var(--c-shape) 45%, transparent));
	}

	.hero__shape--strong {
		top: 58%;
		left: 67.9%;
		width: 5.1%;
		height: 40.4%;
		border-radius: 2.5cqw;
		background: linear-gradient(
			100deg,
			color-mix(in srgb, var(--c-shape-strong) 90%, var(--c-accent)),
			var(--c-shape-strong) 45%,
			color-mix(in srgb, var(--c-shape-strong) 65%, white)
		);
	}

	/* The handwritten slogan. On small screens it sits in the corner the frame leaves free. */
	.hero__slogan {
		position: absolute;
		top: 4%;
		left: 1%;
		display: grid;
		justify-items: start;
		color: var(--c-accent);
		font-family: var(--font-script);
		font-size: clamp(1.0625rem, 5.4cqw, 1.5rem);
		letter-spacing: 0;
		line-height: 1.3;
		word-spacing: -0.22em;
		white-space: nowrap;
		/* The face only comes in one thin weight: a hairline stroke thickens it a little. */
		-webkit-text-stroke: 0.35px currentColor;
		transform: rotate(-12deg);
		transform-origin: left center;
	}

	.hero__slogan span:nth-child(2) {
		margin-left: 0.9em;
	}

	.hero__slogan svg {
		width: 3.1em;
		margin: -0.1em 0 0 3.6em;
		overflow: visible;
	}

	.hero__slogan path {
		fill: none;
		stroke: currentColor;
		stroke-linecap: round;
		stroke-width: 2.2;
	}

	/* ── Panel of cards ─────────────────────────────────── */
	.hero__panel {
		display: grid;
		gap: 1.25rem;
		padding: 1.5rem 0 1.5rem;
		border: 1px solid rgb(255 255 255 / 0.9);
		border-radius: var(--r-lg);
		background: var(--c-panel);
		box-shadow: var(--shadow-soft);
	}

	.hero__intro {
		padding-inline: 1.5rem;
	}

	.hero__panel-title {
		margin-top: 0.6rem;
		color: var(--c-ink);
		font-size: clamp(1.1875rem, 1rem + 0.42vw, 1.34375rem);
		font-weight: 500;
		letter-spacing: -0.01em;
		line-height: 1.27;
	}

	.hero__panel-text {
		max-width: 19rem;
		margin-top: 0.85rem;
		font-size: var(--fs-small);
		line-height: 1.65;
	}

	/* Small screens: the cards sit in a strip that scrolls sideways. */
	.hero__tabs {
		display: flex;
		gap: 0.75rem;
		padding: 0.25rem 1.5rem 0.5rem;
		overflow-x: auto;
		scroll-snap-type: x proximity;
		scrollbar-width: none;
	}

	.hero__tabs::-webkit-scrollbar {
		display: none;
	}

	.hero__tab {
		display: flex;
		flex: none;
		flex-direction: column;
		align-items: center;
		width: 9.75rem;
		padding: 1.25rem 0.5rem 1.3125rem;
		border: 0;
		border-radius: var(--r-md);
		background: var(--c-surface);
		color: color-mix(in srgb, var(--c-ink) 86%, white);
		font-size: var(--fs-label);
		font-weight: 500;
		line-height: 1.3;
		text-align: center;
		cursor: pointer;
		scroll-snap-align: center;
		transition: background-color 0.25s;
	}

	.hero__tab .icon-tile {
		margin-bottom: 0.5rem;
		transition: background-color 0.25s;
	}

	.hero__tab-label {
		text-wrap: balance;
	}

	/* Sits at the foot of the card, also when a label takes two lines. */
	.hero__tab .disc {
		margin-top: auto;
	}

	.hero__tab:hover .disc {
		background: var(--c-tile-strong);
	}

	/* The chosen card: tinted, its icon straight on the tint, its disc stronger. */
	.hero__tab[aria-selected='true'] {
		background: var(--c-tint);
	}

	.hero__tab[aria-selected='true'] .icon-tile {
		background: transparent;
	}

	.hero__tab[aria-selected='true'] .disc {
		background: var(--c-tile-strong);
	}

	.hero__arrows {
		display: flex;
		gap: 0.3125rem;
		justify-content: flex-end;
		padding-inline: 1.5rem;
	}

	/* Phones: a full-width button, with tighter padding so the longest label still fits. */
	@media (max-width: 35.99em) {
		.hero__cta {
			width: 100%;
			padding-inline: 1rem;
		}
	}

	/* ── Large screens: the mockup's layout ─────────────── */
	@media (min-width: 64em) {
		.hero__decor {
			display: block;
		}

		.hero__wrap {
			display: grid;
			grid-template-rows: minmax(0, 1fr) auto;
			min-height: calc(100vh - var(--head) - 4rem);
			min-height: calc(min(100svh, 68rem) - var(--head) - var(--foot));
		}

		.hero__main {
			grid-template-columns: minmax(0, 38.9fr) minmax(0, 61.1fr);
			gap: 0;
			padding-block: 0.6875rem 0;
		}

		/* The message starts a set distance below the top of the frame (less on short screens),
		   and may run lower than the frame when its text is long. */
		.hero__text {
			padding: clamp(0.25rem, 20svh - 6.89rem, 4.125rem) 1rem 1rem clamp(0rem, 4.37vw, 4.875rem);
		}

		.hero__slides {
			margin-top: 1rem;
		}

		.hero__visual {
			container-type: size;
			display: grid;
			align-content: center;
			min-height: 16rem;
			margin-bottom: clamp(1.25rem, 5.7svh, 3.125rem);
		}

		/* As large as the column allows, in width or in height. */
		.hero__stage {
			width: min(100cqw, 224.2cqh);
			aspect-ratio: 944 / 421;
		}

		.hero__frame {
			inset: 0 auto 0 6.57%;
			width: 67.37%;
		}

		.hero__subject {
			clip-path: url(#hero-subject);
		}

		.hero__shape {
			display: block;
		}

		.hero__slogan {
			top: 18.5%;
			left: 83.2%;
			font-size: 2.65cqw;
		}

		.hero__panel {
			grid-template-columns: minmax(12.5rem, 21.3rem) minmax(0, 1fr) auto;
			align-items: center;
			gap: clamp(1rem, 1.8vw, 2rem);
			padding: 1.5rem 2.0625rem 1.4375rem 2.6875rem;
			border-radius: 1.875rem;
		}

		.hero__intro {
			padding-inline: 0;
		}

		.hero__tabs {
			display: grid;
			grid-template-columns: repeat(5, minmax(0, 11.9375rem));
			gap: clamp(0.6rem, 0.87vw, 0.96875rem);
			justify-content: end;
			padding: 0;
			overflow: visible;
		}

		.hero__tab {
			width: auto;
			min-height: 10.0625rem;
			padding-inline: 0.375rem;
		}

		.hero__arrows {
			padding-inline: 0;
		}
	}

	/* Narrow large screens: a wider column for the message, so the tagline stays on one line. */
	@media (min-width: 64em) and (max-width: 79.99em) {
		.hero__main {
			grid-template-columns: minmax(0, 45fr) minmax(0, 55fr);
		}
	}

	/* Laptops (short screens, or not wide enough for the full panel): a lighter panel, without
	   its paragraph or the cards' small arrows, so that everything still fits the first screen. */
	@media (min-width: 64em) and (max-height: 51.99em), (min-width: 64em) and (max-width: 87.99em) {
		.hero {
			--foot: clamp(1rem, 4svh, 2.5rem);
		}

		.hero__lead {
			margin-block: 1rem;
			font-size: 0.9375rem;
		}

		.hero__cta {
			min-height: 2.75rem;
		}

		.hero__visual {
			margin-bottom: clamp(1rem, 3.5svh, 2rem);
		}

		.hero__panel {
			grid-template-columns: minmax(0, clamp(11.5rem, 18vw, 16rem)) minmax(0, 1fr) auto;
			gap: 1rem;
			padding-block: 0.75rem;
		}

		.hero__panel-title {
			margin-top: 0.3rem;
			font-size: clamp(1rem, 0.6rem + 0.62vw, 1.125rem);
		}

		.hero__panel-text,
		.hero__tab .disc {
			display: none;
		}

		.hero__tab {
			min-height: 0;
			padding-block: 0.75rem 0.8rem;
		}

		.hero__tab .icon-tile {
			width: 2.5rem;
			height: 2.5rem;
			margin-bottom: 0.35rem;
			border-radius: 0.875rem;
		}

		.hero__tab .icon-tile :global(.icon) {
			width: 1.375rem;
			height: 1.375rem;
		}
	}
</style>
