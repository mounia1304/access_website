---
// First screen, built after the client's third mockup of it
// (reference/maquette-premier-ecran-3.webp, 1717 x 916): one wide photograph of the port runs
// across the screen, under the menu; panes of glass lie over it (a pale one on the left, which
// carries the message, a dark one in the top right corner, which carries the slogan); a white
// panel with four service cards overlaps its foot.
//
// It shows the first message of the current site's slider ("Transit en douane"). The numbers
// that chose among the five messages were removed at the client's request (2026-10-15), and with
// them the slider: the four other services are the four cards, links to their pages (the mockup
// shows these four). The five messages are still in fr.ts.
//
// THE PHOTOGRAPH was supplied by the client (photos/hero/port.webp, 2000 x 767). The mockup
// shows it a little smaller than the screen, with more sky and sea around it:
// scripts/make-hero-scene.mjs adds those margins (port-scene.webp), so that the lorry, the
// ship and the plane sit where the mockup has them. Of the four small pictures on the cards
// (photos/hero/cards/), all four are the client's own (the lorry, the ship, the plane and the
// ISO shield).
import { Image } from 'astro:assets';
import Icon from './Icon.astro';
import photo from '../assets/photos/hero/port-scene.webp';
import pictureRoutier from '../assets/photos/hero/cards/routier.png';
import pictureMaritime from '../assets/photos/hero/cards/maritime.png';
import pictureAerien from '../assets/photos/hero/cards/aerien.png';
import pictureQualite from '../assets/photos/hero/cards/qualite.png';
import { roundedShape } from './shapes';
import { route, useTranslations } from '../i18n';

const t = useTranslations();
const { hero } = t;

const slide = hero.slides[0];

// The four cards of the panel, in the mockup's order. Each takes its name from the message of
// the same page.
const pictures = { routier: pictureRoutier, maritime: pictureMaritime, aerien: pictureAerien, qualite: pictureQualite };
const cards = (['routier', 'maritime', 'aerien', 'qualite'] as const).map((key) => {
	const slide = hero.slides.find((item) => item.key === key)!;
	return { key, label: `${slide.title} ${slide.mark}`, picture: pictures[key] };
});

// The panes, measured on the mockup in px, for a scene of 1717 x 659 (the photograph at the
// mockup's width). Their slanted sides all lean alike (about 36 degrees).
const SCENE = { width: 1717, height: 659 };
// The pale pane: everything left of a slanted side that comes down from the top (1236px in),
// steps to the left along a nearly level edge, then comes down again to the foot.
const veilShape = roundedShape(
	[
		[0, 0],
		[1236, 0],
		[1030, 283],
		[790, 328],
		[544, 659],
		[0, 659],
	],
	[0, 0, 44, 30, 0, 0],
	SCENE.width,
	SCENE.height,
);
// The dark tint over the sky: everything right of the pale pane's upper side.
const shadeShape = roundedShape(
	[
		[1236, 0],
		[1717, 0],
		[1717, 659],
		[754, 659],
	],
	[0, 0, 0, 0],
	SCENE.width,
	SCENE.height,
);
// A darker pane in the far corner.
const cornerShape = roundedShape(
	[
		[1717, 88],
		[1717, 376],
		[1512, 376],
	],
	[0, 0, 0],
	SCENE.width,
	SCENE.height,
);
// The panel: a rounded box whose left side leans (box of 1552 x 182).
const panelShape = roundedShape(
	[
		[72, 0],
		[1552, 0],
		[1552, 182],
		[0, 182],
	],
	[26, 30, 30, 34],
	1552,
	182,
);
---

<section class="hero" aria-label={hero.label}>
	<h1 class="visually-hidden">{hero.h1}</h1>

	<svg class="hero__defs" width="0" height="0" aria-hidden="true" focusable="false">
		<defs>
			<clipPath id="hero-veil" clipPathUnits="objectBoundingBox"><path d={veilShape}></path></clipPath>
			<clipPath id="hero-shade" clipPathUnits="objectBoundingBox"><path d={shadeShape}></path></clipPath>
			<clipPath id="hero-corner" clipPathUnits="objectBoundingBox"><path d={cornerShape}></path></clipPath>
			<clipPath id="hero-panel" clipPathUnits="objectBoundingBox"><path d={panelShape}></path></clipPath>
		</defs>
	</svg>

	<div class="hero__stage">
		<!-- The photograph and the panes laid over it. -->
		<div class="hero__scene">
			<Image
				class="hero__photo"
				src={photo}
				alt={hero.imageAlt}
				widths={[768, 1280, 1717, photo.width]}
				sizes="(min-width: 64em) 100vw, 165vw"
				quality={90}
				priority
			/>
			<span class="hero__shade" aria-hidden="true"></span>
			<span class="hero__corner" aria-hidden="true"></span>
			<span class="hero__veil" aria-hidden="true"></span>
			<!-- The edge of the pale pane where it meets the picture: orange, then pale blue. -->
			<svg class="hero__edge" viewBox="0 0 1717 659" preserveAspectRatio="none" aria-hidden="true" focusable="false">
				<defs>
					<linearGradient id="hero-edge-line" gradientUnits="userSpaceOnUse" x1="556" y1="0" x2="1010" y2="0">
						<stop class="hero__edge-warm" offset="0" stop-opacity="0"></stop>
						<stop class="hero__edge-warm" offset="0.14"></stop>
						<stop class="hero__edge-warm" offset="0.5"></stop>
						<stop class="hero__edge-cool" offset="0.6"></stop>
						<stop class="hero__edge-cool" offset="1" stop-opacity="0"></stop>
					</linearGradient>
				</defs>
				<path d="M560 640L770 356Q790 329 822 322L1010 287" stroke="url(#hero-edge-line)"></path>
			</svg>
			<p class="hero__slogan">
				<span>{hero.slogan[0]}</span>
				<span>{hero.slogan[1]}</span>
			</p>
		</div>

		<div class="hero__content">
			<p class="hero__tagline">{hero.tagline}</p>

			<div class="hero__slide">
				<h2 class="hero__title">
					{slide.title} <span class="hero__mark">{slide.mark}</span>
				</h2>
				<p class="hero__lead">{slide.text}</p>
				<div class="hero__actions">
					<a class="btn btn--accent hero__cta" href={route(slide.key)}>
						{slide.cta}
						<Icon name="arrow-right" size={16} />
					</a>
					<a class="hero__more" href="#entreprise" title={hero.savoirFaire}>
						<span class="hero__play">
							<Icon name="play-solid" />
						</span>
						<span class="hero__more-label">{hero.savoirFaire}</span>
					</a>
				</div>
			</div>
		</div>
	</div>

	<div class="hero__panel">
		<span class="hero__panel-accent" aria-hidden="true"></span>
		<div class="hero__intro">
			<p class="hero__panel-eyebrow">{hero.panel.eyebrow}</p>
			<p class="hero__panel-title">
				{hero.panel.title[0]}<br />{hero.panel.title[1]}
			</p>
			<a class="hero__panel-link" href="#services">
				{hero.panel.link}
				<Icon name="arrow-right" />
			</a>
		</div>

		<ul class="hero__cards">
			{
				cards.map((card) => (
					<li class:list={["hero__card", `hero__card--${card.key}`]}>
						<Image class="hero__card-picture" src={card.picture} alt="" width={card.picture.width} loading="eager" />
						<a class="hero__card-link" href={route(card.key)}>
							{card.label}
						</a>
						<Icon name="arrow-right" class="hero__card-arrow" />
					</li>
				))
			}
		</ul>
	</div>
</section>

<style>
	/*
	 * Large screens follow the mockup's measures (1717 x 916), given in hundredths of the
	 * screen's width (cqw: 17.17px on the mockup), so the first screen scales as a whole with
	 * the width, like a poster; small texts have floors under which they stop shrinking.
	 * Under 64em the photograph becomes a band at the top and everything stacks.
	 *
	 * The menu floats over the photograph: the block is pulled up under it.
	 */
	.hero {
		position: relative;
		container-type: inline-size;
		isolation: isolate;
		margin-top: calc(-1 * var(--header-h-top));
		padding-bottom: clamp(2rem, 3.5vw, 4rem);
	}

	.hero__defs {
		position: absolute;
	}

	/* ── The photograph and its panes ───────────────────── */
	.hero__stage {
		position: relative;
	}

	/* Small screens: a band, which shows the plane, the lorry and the ship. */
	.hero__scene {
		position: relative;
		height: max(64cqw, 15rem);
		overflow: hidden;
		/* The foot of the band dissolves into the page. */
		-webkit-mask-image: linear-gradient(to bottom, #000 82%, transparent);
		mask-image: linear-gradient(to bottom, #000 82%, transparent);
	}

	.hero__scene :global(.hero__photo) {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		object-fit: cover;
		object-position: 70% 50%;
	}

	/* Behind the menu, the sky is veiled so that the menu's bar reads. */
	.hero__veil {
		position: absolute;
		inset: 0;
		background: linear-gradient(to bottom, color-mix(in srgb, var(--c-bg) 55%, transparent), transparent 45%);
	}

	.hero__shade,
	.hero__corner,
	.hero__edge,
	.hero__slogan {
		display: none;
	}

	/* ── The message ────────────────────────────────────── */
	.hero__content {
		padding: 1.5rem var(--gutter) 0;
	}

	/* A short orange line, then the tagline in spaced capitals. */
	.hero__tagline {
		display: flex;
		align-items: center;
		gap: 0.85em;
		color: var(--c-accent);
		font-size: 0.8985rem;
		font-weight: 600;
		letter-spacing: 0.2em;
		line-height: 1.25rem;
		text-transform: uppercase;
	}

	.hero__tagline::before {
		content: '';
		flex: none;
		width: 2.5em;
		height: 2px;
		border-radius: 2px;
		background: var(--c-stroke);
	}

	.hero__slide {
		display: flex;
		flex-direction: column;
		align-items: flex-start;
		margin-top: 0.75rem;
	}

	/* Two lines, very bold: the first navy, the second in the logo's orange, lighter at the
	   top of the letters and deeper at their foot, like the logo's lettering. */
	.hero__title {
		font-size: clamp(2.75rem, 13cqw, 4.5rem);
		font-weight: 800;
		letter-spacing: -0.035em;
		line-height: 0.9;
	}

	.hero__mark {
		display: block;
		color: var(--c-display);
	}

	@supports ((-webkit-background-clip: text) or (background-clip: text)) {
		.hero__mark {
			width: fit-content;
			/* Room for the descenders, which the line box would otherwise cut off the picture. */
			margin-bottom: -0.12em;
			padding-bottom: 0.12em;
			background: var(--g-display);
			-webkit-background-clip: text;
			background-clip: text;
			color: transparent;
		}
	}

	.hero__lead {
		max-width: 27.5em;
		margin-top: 1rem;
		color: var(--c-text-strong);
		line-height: 1.47;
		text-wrap: balance;
	}

	.hero__actions {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 1rem 1.5rem;
		margin-top: 1.5rem;
	}

	.hero__cta {
		min-height: 3.25rem;
		padding-inline: 2rem;
		font-weight: 600;
		box-shadow:
			inset 0 0 0 10rem transparent,
			0 0.6rem 1.4rem color-mix(in srgb, var(--c-accent) 28%, transparent);
	}

	.hero__cta:hover {
		box-shadow:
			inset 0 0 0 10rem rgb(0 0 0 / 0.16),
			0 0.6rem 1.4rem color-mix(in srgb, var(--c-accent) 28%, transparent);
	}

	/* A round "play" button and its label: leads to the film of the second screen. */
	.hero__more {
		display: inline-flex;
		align-items: center;
		gap: 0.7rem;
		color: var(--c-ink);
		font-size: 1.0157rem;
		font-weight: 600;
		line-height: 1.25rem;
	}

	.hero__play {
		display: inline-flex;
		flex: none;
		align-items: center;
		justify-content: center;
		width: 2.625rem;
		height: 2.625rem;
		border: 1.5px solid color-mix(in srgb, var(--c-ink) 28%, transparent);
		border-radius: 50%;
		color: var(--c-accent);
		transition:
			background-color 0.25s,
			border-color 0.25s,
			color 0.25s;
	}

	.hero__play :global(.icon) {
		width: 36%;
		height: auto;
		margin-left: 6%;
	}

	.hero__more:hover .hero__play {
		border-color: var(--c-accent);
		background: var(--c-accent);
		color: var(--c-on-accent);
	}

	/* ── The panel of cards ─────────────────────────────── */
	.hero__panel {
		--radius: 1.5rem;
		position: relative;
		z-index: 1;
		display: grid;
		gap: 1.25rem;
		margin: 2rem var(--gutter) 0;
		padding: 1.5rem 1.25rem 1.25rem;
		/* A shadow that follows the panel's own outline. */
		filter: drop-shadow(0 0.9rem 1.6rem rgb(22 60 130 / 0.1)) drop-shadow(0 1px 2px rgb(22 60 130 / 0.05));
	}

	.hero__panel::before {
		content: '';
		position: absolute;
		inset: 0;
		z-index: -1;
		border-radius: var(--radius);
		background: var(--c-surface);
	}

	.hero__panel-accent {
		display: none;
	}

	.hero__intro {
		display: grid;
		justify-items: start;
	}

	/* The label in spaced capitals, then a short orange line. */
	.hero__panel-eyebrow {
		display: flex;
		align-items: center;
		gap: 0.85em;
		color: var(--c-accent);
		font-size: 0.9375rem;
		font-weight: 600;
		letter-spacing: 0.2em;
		line-height: 1.25rem;
		text-transform: uppercase;
	}

	.hero__panel-eyebrow::after {
		content: '';
		width: 2.5em;
		height: 2px;
		border-radius: 2px;
		background: var(--c-stroke);
	}

	.hero__panel-title {
		margin-top: 0.5rem;
		color: var(--c-ink);
		font-size: 1.7186rem;
		font-weight: 500;
		letter-spacing: -0.01em;
		line-height: 1.1;
	}

	.hero__panel-link {
		display: inline-flex;
		align-items: center;
		gap: 0.45em;
		margin-top: 1rem;
		color: var(--c-accent);
		font-size: 1.0157rem;
		font-weight: 500;
		line-height: 1.25rem;
	}

	.hero__panel-link :global(.icon) {
		width: 1.05em;
		height: auto;
		transition: transform 0.25s var(--ease);
	}

	.hero__panel-link:hover :global(.icon) {
		transform: translateX(3px);
	}

	.hero__cards {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: 0.75rem;
	}

	/* A pale tile: the picture at the top, the name and an arrow at the foot. The link in the
	   name covers the whole tile. */
	.hero__card {
		position: relative;
		display: grid;
		grid-template-columns: minmax(0, 1fr) auto;
		align-items: end;
		gap: 0.25rem 0.5rem;
		min-height: 7.5rem;
		padding: 0.6rem 0.85rem 0.85rem;
		border-radius: 1.125rem;
		background: var(--c-tint);
		transition:
			background-color 0.3s,
			box-shadow 0.3s,
			translate 0.4s var(--ease);
	}

	.hero__card :global(.hero__card-picture) {
		grid-column: 1 / -1;
		align-self: center;
		justify-self: center;
		width: auto;
		height: clamp(3.5rem, 18cqw, 4.5rem);
		transition: translate 0.4s var(--ease);
	}

	/* The lorry, the ship and the plane are the client's own pictures: they asked for them a
	   quarter smaller than the cards' pictures are by default. */
	:is(.hero__card--routier, .hero__card--maritime, .hero__card--aerien) :global(.hero__card-picture) {
		scale: 0.75;
	}

	/* The ISO shield, also the client's own: 5% smaller, as asked. */
	.hero__card--qualite :global(.hero__card-picture) {
		scale: 0.95;
	}

	.hero__card-link {
		color: var(--c-ink);
		font-size: 1.0157rem;
		font-weight: 500;
		line-height: 1.25;
	}

	.hero__card-link::after {
		content: '';
		position: absolute;
		inset: 0;
		border-radius: inherit;
	}

	.hero__card-link:focus-visible {
		outline: 0;
	}

	.hero__card:has(.hero__card-link:focus-visible) {
		outline: 2px solid var(--c-accent);
		outline-offset: 3px;
	}

	.hero__card :global(.hero__card-arrow) {
		width: 1.125rem;
		height: auto;
		color: var(--c-accent);
		transition: transform 0.3s var(--ease);
	}

	@media (hover: hover) {
		.hero__card:hover {
			background: var(--c-surface);
			box-shadow: var(--shadow-pop);
			translate: 0 calc(var(--motion) * -0.25rem);
		}

		.hero__card:hover :global(.hero__card-picture) {
			translate: 0 calc(var(--motion) * -0.125rem);
		}

		.hero__card:hover :global(.hero__card-arrow) {
			transform: translateX(3px);
		}
	}

	/* Phones: a full-width button. */
	@media (max-width: 35.99em) {
		.hero__cta {
			flex: 1 1 100%;
		}
	}

	/* ── Large screens: the mockup's layout ─────────────── */
	@media (min-width: 64em) {
		.hero {
			padding-bottom: clamp(2rem, 3.2cqw, 4rem);
		}

		/* The stage is as tall as the photograph at the screen's width (taller only if the
		   message needs it). The photograph and its panes lie behind the message. */
		.hero__stage {
			min-height: 38.38cqw;
			padding-top: 10.37cqw;
			padding-bottom: 4.3cqw;
		}

		.hero__scene {
			position: absolute;
			inset: 0;
			height: auto;
			-webkit-mask-image: none;
			mask-image: none;
		}

		.hero__scene :global(.hero__photo) {
			object-position: 50% 50%;
		}

		.hero__shade,
		.hero__corner,
		.hero__veil,
		.hero__edge {
			display: block;
			position: absolute;
			inset: 0;
		}

		/* The pale pane: the page's colour, thicker on the left, where the message is. */
		.hero__veil {
			background: linear-gradient(
				to right,
				color-mix(in srgb, var(--c-bg) 80%, transparent),
				color-mix(in srgb, var(--c-bg) 62%, transparent) 38%,
				color-mix(in srgb, var(--c-bg) 40%, transparent) 72%
			);
			clip-path: url(#hero-veil);
			/* It thins out a little at the foot, where the sea shows through (not more: the numbers
			   of the messages are read there, over the sun's reflection). */
			-webkit-mask-image: linear-gradient(to bottom, #000 80%, rgb(0 0 0 / 0.62));
			mask-image: linear-gradient(to bottom, #000 80%, rgb(0 0 0 / 0.62));
		}

		/* The dark tint over the sky, strongest in the top right corner. */
		.hero__shade {
			--tint: color-mix(in srgb, var(--c-accent) 55%, var(--c-ink));
			background: linear-gradient(
				200deg,
				color-mix(in srgb, var(--tint) 74%, transparent),
				color-mix(in srgb, var(--tint) 52%, transparent) 14%,
				transparent 36%
			);
			clip-path: url(#hero-shade);
		}

		.hero__corner {
			background: linear-gradient(to bottom, color-mix(in srgb, var(--c-ink) 44%, transparent) 46%, transparent 57%);
			clip-path: url(#hero-corner);
		}

		.hero__edge {
			width: 100%;
			height: 100%;
			fill: none;
			stroke-linecap: round;
			stroke-width: 6;
		}

		.hero__edge-warm {
			stop-color: var(--c-stroke);
		}

		.hero__edge-cool {
			stop-color: var(--c-tile-strong);
		}

		/* The slogan, in white on the dark pane, beside an orange line. */
		.hero__slogan {
			display: grid;
			position: absolute;
			top: 24.4%;
			left: 83.87%;
			padding: 0.85cqw 0 0.3cqw 1.25cqw;
			border-left: max(2px, 0.14cqw) solid var(--c-stroke);
			color: var(--c-on-accent);
			font-size: clamp(1.0157rem, 1.1575cqw, 1.5625rem);
			font-weight: 500;
			line-height: 1.55;
			white-space: nowrap;
		}

		.hero__content {
			position: relative;
			padding: 0 0 0 6.99cqw;
		}

		.hero__tagline {
			font-size: clamp(0.8593rem, 0.9462cqw, 1.25rem);
		}

		.hero__slide {
			margin-top: 0.52cqw;
		}

		.hero__title {
			font-size: 5.3cqw;
			line-height: 0.846;
		}

		.hero__lead {
			/* Stays clear of the picture's slanted edge. */
			max-width: min(27.5em, 33cqw);
			margin-top: 1.1cqw;
			font-size: clamp(1.0936rem, 1.1875cqw, 1.5625rem);
		}

		.hero__actions {
			gap: 0.75rem 1.4cqw;
			margin-top: 1.63cqw;
		}

		.hero__cta {
			gap: 1.1cqw;
			min-height: clamp(2.75rem, 3.26cqw, 4rem);
			padding-inline: 1.9cqw;
			font-size: clamp(0.875rem, 1.025cqw, 1.3282rem);
		}

		.hero__cta :global(.icon) {
			width: 1.15em;
			height: auto;
		}

		.hero__more {
			gap: 0.65cqw;
			font-size: clamp(0.75rem, 0.9125cqw, 1.1718rem);
		}

		.hero__play {
			width: clamp(2.25rem, 2.45cqw, 3rem);
			height: clamp(2.25rem, 2.45cqw, 3rem);
		}

		/* The panel overlaps the foot of the photograph; its left side leans. */
		.hero__panel {
			--radius: 0;
			grid-template-columns: minmax(0, 24.6fr) minmax(0, 75.4fr);
			align-items: center;
			gap: 0;
