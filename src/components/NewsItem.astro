---
// A news item in a list of the Actualités page, in one of three forms:
// - "lead": the item "À la une", with its picture;
// - "row": a line of the list of all the news: its date in a column, its kind, title and
//   description, a small picture on the right (from tablets up);
// - "compact": a line beside the item "À la une", or under a news item: its date and title.
// The link in the title covers the whole item.
import BlogCover from './BlogCover.astro';
import { formatDate, isoDate } from '../utils/blog';
import { hrefOf, typeOf, type News } from '../utils/news';

interface Props {
	item: News;
	variant?: 'lead' | 'row' | 'compact';
	heading?: 'h2' | 'h3';
	eager?: boolean;
}

const { item, variant = 'row', heading: Heading = 'h3', eager = false } = Astro.props;
const type = typeOf(item.data.type);
const date = item.data.date;
const day = new Intl.DateTimeFormat('fr-FR', { day: '2-digit', timeZone: 'UTC' }).format(date);
const month = new Intl.DateTimeFormat('fr-FR', { month: 'short', year: 'numeric', timeZone: 'UTC' }).format(date);
---

<article class:list={['news', `news--${variant}`]} data-type={item.data.type}>
	{
		variant === 'row' && (
			<time class="news__date" datetime={isoDate(date)}>
				<span class="news__day">{day}</span>
				<span class="news__month">{month}</span>
			</time>
		)
	}
	{
		variant !== 'compact' && (
			<BlogCover
				cover={item.data.cover}
				alt={item.data.coverAlt}
				icon={type.icon}
				tone={type.tone}
				sizes={variant === 'lead' ? '(min-width: 64em) 56vw, 92vw' : '12rem'}
				eager={eager}
				whole
				class="news__cover"
			/>
		)
	}
	<div class="news__body">
		<p class="news__meta">
			<span class="news__type">{type.name}</span>
			{variant !== 'row' && <time datetime={isoDate(date)}>{formatDate(date)}</time>}
		</p>
		<Heading class="news__title">
			<a class="card__link" href={hrefOf(item)}>{item.data.title}</a>
		</Heading>
		{variant !== 'compact' && <p class="news__desc">{item.data.description}</p>}
	</div>
</article>

<style>
	.news {
		position: relative;
	}

	/* The link in the title covers the whole item. */
	.news :global(.card__link)::after {
		z-index: 1;
	}

	.news:has(:global(.card__link:focus-visible)) {
		outline: 2px solid var(--c-accent);
		outline-offset: 0.5rem;
		border-radius: 0.75rem;
	}

	.news__body {
		display: grid;
		align-content: start;
		gap: 0.5rem;
		min-width: 0;
	}

	/* The kind, after the site's thin orange stroke, and the date. */
	.news__meta {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 0.25rem 0.9rem;
		font-size: var(--fs-label);
		font-variant-numeric: tabular-nums;
	}

	.news__type {
		display: inline-flex;
		align-items: center;
		gap: 0.7rem;
		color: var(--c-label);
		font-size: var(--fs-eyebrow);
		font-weight: 700;
		letter-spacing: 0.14em;
		text-transform: uppercase;
	}

	.news__type::before {
		content: '';
		flex: none;
		width: 2px;
		height: 1.15em;
		border-radius: 2px;
		background: var(--g-bar);
		rotate: calc(var(--slant) * -1);
	}

	.news__title {
		font-size: clamp(1.1875rem, 1.05rem + 0.45vw, 1.4375rem);
		font-weight: 700;
		letter-spacing: -0.015em;
		line-height: 1.25;
	}

	.news__title a {
		transition: color 0.2s;
	}

	.news__desc {
		display: -webkit-box;
		-webkit-box-orient: vertical;
		-webkit-line-clamp: 2;
		overflow: hidden;
		font-size: var(--fs-small);
		line-height: 1.6;
	}

	@media (hover: hover) {
		.news:hover .news__title a {
			color: var(--c-accent);
		}

		.news:hover :global(.news__cover img) {
			scale: calc(1 + var(--motion) * 0.03);
		}
	}

	/* "À la une". */
	.news--lead {
		display: grid;
		gap: 1.5rem;
	}

	.news--lead :global(.news__cover) {
		--cover-ratio: 16 / 9;
		--cover-ratio-empty: 2.2 / 1;
		--cover-r: var(--r-lg);
	}

	.news--lead .news__title {
		font-size: clamp(1.625rem, 1.15rem + 1.5vw, 2.375rem);
		letter-spacing: -0.025em;
		line-height: 1.15;
	}

	.news--lead .news__desc {
		-webkit-line-clamp: 4;
		font-size: var(--fs-body);
	}

	/* A line of the list: the date in a column; the picture on the right from tablets up. */
	.news--row {
		display: grid;
		grid-template-columns: 4.5rem minmax(0, 1fr);
		gap: 1.25rem;
		padding-block: 1.75rem;
		border-bottom: 1px solid var(--c-line);
	}

	.news__date {
		display: grid;
		align-content: start;
		gap: 0.15rem;
		color: var(--c-ink);
		font-variant-numeric: tabular-nums;
	}

	.news__day {
		font-size: clamp(1.75rem, 1.5rem + 0.8vw, 2.25rem);
		font-weight: 700;
		letter-spacing: -0.03em;
		line-height: 1;
	}

	.news__month {
		font-size: var(--fs-label);
		line-height: 1.2;
	}

	.news--row :global(.news__cover) {
		display: none;
	}

	@media (min-width: 48em) {
		.news--row {
			grid-template-columns: 6rem minmax(0, 1fr) 12rem;
			column-gap: 2rem;
		}

		.news--row :global(.news__cover) {
			display: block;
			grid-area: 1 / 3;
			--cover-r: 0.875rem;
			--cover-icon: 34cqw;
		}

		.news--row .news__body {
			grid-area: 1 / 2;
		}
	}

	/* A line beside "À la une", or under a news item. */
	.news--compact {
		padding-block: 1.1rem;
		border-bottom: 1px solid var(--c-line);
	}

	.news--compact .news__title {
		font-size: var(--fs-h3);
		line-height: 1.3;
	}
</style>
