---
// PROVISIONAL LOGO. The mark and the lettering are a stand-in; the real logo is still being
// designed. When it is ready, replace the markup below with the logo image (one version for
// light backgrounds, one for the footer's coloured background) — the header, the mobile menu
// and the footer all use this component.
import { site } from '../data/site';
import { useTranslations } from '../i18n';

interface Props {
	/** Background the logo sits on: 'dark' gives the white version. */
	tone?: 'light' | 'dark';
}

const { tone = 'light' } = Astro.props;
const t = useTranslations();
---

<span class:list={['logo', `logo--${tone}`]} title={t.common.logoSlot}>
	<svg class="logo__mark" viewBox="0 0 48 40" aria-hidden="true" focusable="false">
		<path class="logo__facet" d="M2 20 15 8l11 12z"></path>
		<path d="M2 20h24L15 32z"></path>
		<path d="M19 2h12l16 18-16 18H19l16-18z"></path>
	</svg>
	<span class="logo__name">{site.brand}</span>
</span>

<style>
	.logo {
		display: inline-flex;
		align-items: center;
		gap: 0.95rem;
		color: var(--c-accent);
		font-family: var(--font-sans);
		line-height: 1;
		white-space: nowrap;
	}

	.logo__mark {
		flex: none;
		width: auto;
		height: 2rem;
		fill: currentColor;
	}

	.logo__facet {
		opacity: 0.5;
	}

	.logo__name {
		font-size: 1.0625rem;
		font-weight: 500;
		letter-spacing: 0.08em;
	}

	.logo--dark {
		color: var(--c-on-accent);
	}

	@media (min-width: 60em) {
		.logo__mark {
			height: 2.5rem;
		}

		.logo__name {
			font-size: 1.125rem;
		}
	}
</style>
