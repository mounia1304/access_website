---
// The picture at the head of an article of the blog or of a news item, on its card and on its
// page. Until it has a photo (cover, in its file), a drawn icon (its category's, or its kind's)
// stands on a pale ground, with the thin orange stroke of the site's screens in a corner. The
// client asked for the photos to wait.
//
// Its proportions are --cover-ratio (3 / 2 unless the place that shows it says otherwise), or
// --cover-ratio-empty while it has no photo (a large empty frame would be mostly blank), its
// corners --cover-r, and the size of its icon --cover-icon (in cqw: hundredths of its width).
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';
import ServiceIcon from './ServiceIcon.astro';
import type { ServiceIconName } from './serviceIcons';

interface Props {
	cover?: ImageMetadata;
	alt?: string;
	/** The drawn icon shown while there is no photo, and the colour of its ground. */
	icon: ServiceIconName;
	tone: 'blue' | 'warm';
	/** How wide the picture is shown, for the browser to fetch the right size. */
	sizes: string;
	eager?: boolean;
	class?: string;
}

const { cover, alt = '', icon, tone, sizes, eager = false, class: className } = Astro.props;
---

<div class:list={['cover', `cover--${tone}`, { 'cover--empty': !cover }, className]}>
	{
		cover ? (
			<Image src={cover} alt={alt} widths={[480, 800, 1200, 1600]} sizes={sizes} loading={eager ? 'eager' : 'lazy'} />
		) : (
			<span class="cover__empty" aria-hidden="true">
				<ServiceIcon name={icon} class="cover__icon" />
			</span>
		)
	}
</div>

<style>
	.cover {
		--ground: var(--c-panel);
		position: relative;
		container-type: inline-size;
		aspect-ratio: var(--cover-ratio, 3 / 2);
		border-radius: var(--cover-r, 1.25rem);
		background: var(--ground);
		overflow: hidden;
	}

	.cover--warm {
		--ground: var(--c-card-warm);
	}

	.cover--empty {
		aspect-ratio: var(--cover-ratio-empty, var(--cover-ratio, 3 / 2));
	}

	.cover :global(img) {
		width: 100%;
		height: 100%;
		object-fit: cover;
		transition: scale 0.6s var(--ease);
	}

	.cover__empty {
		position: absolute;
		inset: 0;
		display: grid;
		place-items: center;
		border: 1px solid var(--c-card-line);
		border-radius: inherit;
	}

	/* The stroke of the site's screens. */
	.cover__empty::before {
		content: '';
		position: absolute;
		top: 11%;
		left: 8%;
		width: 2px;
		height: 17%;
		border-radius: 2px;
		background: var(--g-bar);
		rotate: calc(var(--slant) * -1);
	}

	/* The icon's cut-outs take the ground's colour. */
	.cover :global(.cover__icon) {
		--sicon: var(--cover-icon, clamp(2.5rem, 21cqw, 7.5rem));
		--sicon-ground: var(--ground);
	}
</style>
