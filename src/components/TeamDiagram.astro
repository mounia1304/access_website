---
// The team, drawn as the director's diagram (sent as a picture, to be reproduced): the general
// manager in the middle, in a large round frame over a blue name plate, his number and address
// in a box under it; round him, each joined to him by a line, seven cards. Each card has the
// person's round photo at its inner end (towards the middle), a small icon of their trade, the
// name, the role, then the number and the address. The director asked for the logo's blue and
// orange in place of the picture's blue and green: the cards on the left are blue, those on the
// right and at the top orange.
//
// A first version followed the picture to the letter (gradient discs with white rims, glows,
// everything in capitals, a short bar under each name, pale gradient cards); the client found it
// "AI generated" and asked for the same design made by an expert. So the layout is the same,
// the finish is quiet: white cards with a hairline, names in their usual case, thin rings round
// the photos, flat icons inside the cards, hairline orbits round the general manager on which
// the lines land. Colour marks what belongs to whom; nothing glows.
//
// PHOTOS AND MISSING CONTACTS. There are no photos yet: each frame shows the person's initials
// until the client sends them. A number or an address not sent yet (null in the texts file) is
// replaced by a short note saying it is to come.
//
// From 80em it is the diagram itself: a stage in about the proportions of the picture (1536 by
// 1100), on which everything is placed in the picture's own px (--u is one of them), so that
// the whole diagram scales with the width. Below that the cards are a list under the general
// manager.
//
// MOVEMENT: as the page opens, the general manager appears and the cards come out one after the
// other (large screens; on small ones each card comes up as it is scrolled to). Pointing at a
// card, or reaching it with the keyboard, brings out its line to the general manager. None of
// the movement for prefers-reduced-motion.
import Icon from './Icon.astro';
import type { IconName } from './icons';
import { useTranslations } from '../i18n';
import { initialsOf } from '../utils/text';

const t = useTranslations();
const { contact } = t.pages;

// Where each card sits on the stage, in px of the director's picture, in the order of the texts
// file: x, y (top left corner), w, h (width, smallest height), side (where the card lies: its
// photo faces the middle), pin (from the card's inner edge to the centre of its photo; negative:
// outside the card) and foot (where its line lands: by default on the orbit round the general
// manager; the two at the foot, whose part of the orbit is hidden by his plate and box, land on
// that box instead, at the client's request: they join him like the others).
type Place = {
	x: number;
	y: number;
	w: number;
	h: number;
	side: 'left' | 'right';
	pin?: number;
	foot?: boolean;
};
// The general manager's photo: its centre, and the orbit the lines land on.
const LEAD = { x: 765, y: 470, r: 215 };
const PHOTO_R = 80;
// The two lower lines run into the box under the general manager and end behind it. Its foot is
// 724 to 734 px down (its text keeps a larger size on smaller screens), and a card that grows
// moves its line down with it: ending 25 px inside the box keeps them joined to it at every width.
const BOX_FOOT = 700;
const PLACES: Place[] = [
	{ x: 700, y: 20, w: 475, h: 155, side: 'right', pin: -32 },
	{ x: 35, y: 235, w: 510, h: 170, side: 'left' },
	{ x: 985, y: 235, w: 515, h: 170, side: 'right' },
	{ x: 25, y: 515, w: 495, h: 200, side: 'left' },
	{ x: 1015, y: 515, w: 495, h: 205, side: 'right' },
	{ x: 80, y: 800, w: 580, h: 200, side: 'left', foot: true },
	{ x: 870, y: 800, w: 585, h: 200, side: 'right', foot: true },
];
// The colour of each card: blue on the left, orange at the top and on the right.
const TONES = ['warm', 'blue', 'warm', 'blue', 'warm', 'blue', 'warm'] as const;

const contactOf = (person: { phone: string | null; email: string | null }) => ({
	phone: person.phone,
	tel: person.phone ? `tel:${person.phone.replace(/\s/g, '')}` : null,
	// The two halves of the address: a long one breaks before its @, not in the middle of a word.
	mail: person.email ? person.email.split('@') : null,
	email: person.email,
});

const director = { ...contact.director, ...contactOf(contact.director), initials: initialsOf(contact.director.name) };
const members = contact.members.map((person, index) => {
	const place = PLACES[index];
	const pin = place.pin ?? 82;
	// The line leaves the photo's ring towards the middle: it belongs to the card, so that it
	// stays on the photo when the card grows. Its angle and length come from the card's place.
	const px = place.side === 'left' ? place.x + place.w - pin : place.x + pin;
	const py = place.y + place.h / 2;
	// Towards the middle; it stops on the orbit, or on the foot of the box (where the line towards
	// the middle crosses it).
	const t = place.foot ? (py - BOX_FOOT) / (py - LEAD.y) : 0;
	const stop = place.foot ? Math.hypot(px + (LEAD.x - px) * t - LEAD.x, BOX_FOOT - LEAD.y) : LEAD.r;
	const angle = (Math.atan2(LEAD.y - py, LEAD.x - px) * 180) / Math.PI;
	const length = Math.max(24, Math.hypot(LEAD.x - px, LEAD.y - py) - PHOTO_R - stop);
	return {
		...person,
		...contactOf(person),
		initials: initialsOf(person.name),
		icon: person.icon as IconName,
		tone: TONES[index],
		side: place.side,
		style: [
			`--i: ${index}`,
			`--x: ${place.x}`,
			`--y: ${place.y}`,
			`--w: ${place.w}`,
			`--h: ${place.h}`,
			`--pin: ${pin}`,
			`--pad: ${pin + PHOTO_R + 24}`,
			`--angle: ${angle.toFixed(1)}deg`,
			`--len: ${length.toFixed(0)}`,
		].join('; '),
	};
});
---

<div class="team">
	<div class="team__stage">
		<svg class="team__orbits" viewBox="0 0 1536 1100" aria-hidden="true" focusable="false">
			<circle class="orbit orbit--outer" cx="765" cy="470" r="330"></circle>
			<circle class="orbit" cx="765" cy="470" r="215"></circle>
		</svg>

		<!-- The general manager. -->
		<div class="lead">
			<span class="lead__photo photo" aria-hidden="true"><span class="photo__in">{director.initials}</span></span>
			<div class="lead__plate">
				<h3>{director.name}</h3>
				<p>{director.role}</p>
			</div>
			<div class="lead__box">
				{
					director.tel || director.mail ? (
						<ul class="ways">
							{director.tel && (
								<li>
									<a href={director.tel}>
										<Icon name="phone" />
										<span class="ways__text">{director.phone}</span>
									</a>
								</li>
							)}
							{director.mail && (
								<li>
									<a href={`mailto:${director.email}`}>
										<Icon name="envelope" />
										<span class="ways__text">
											{director.mail[0]}
											<wbr />@{director.mail[1]}
										</span>
									</a>
								</li>
							)}
						</ul>
					) : (
						<p class="pending">{contact.pending}</p>
					)
				}
			</div>
		</div>

		<!-- The seven round him. -->
		<ul class="team__members">
			{
				members.map((member) => (
					<li class:list={['member', `member--${member.side}`, `member--${member.tone}`]} style={member.style}>
						<span class="member__link" aria-hidden="true" />
						<span class="member__photo photo" aria-hidden="true">
							<span class="photo__in">{member.initials}</span>
						</span>
						<div class="member__body">
							<div class="member__head">
								<div class="member__who">
									<h3>{member.name}</h3>
									<p class="member__role">{member.role}</p>
								</div>
								<span class="member__icon" aria-hidden="true">
									<Icon name={member.icon} />
								</span>
							</div>
							{member.tel || member.mail ? (
								<ul class="ways">
									{member.tel && (
										<li>
											<a href={member.tel}>
												<Icon name="phone" />
												<span class="ways__text">{member.phone}</span>
											</a>
										</li>
									)}
									{member.mail && (
										<li>
											<a href={`mailto:${member.email}`}>
												<Icon name="envelope" />
												<span class="ways__text">
													{member.mail[0]}
													<wbr />@{member.mail[1]}
												</span>
											</a>
										</li>
									)}
								</ul>
							) : (
								<p class="pending">{contact.pending}</p>
							)}
						</div>
					</li>
				))
			}
		</ul>
	</div>
</div>

<style>
	/* --hot is 1 while a card is pointed at or holds the keyboard's focus. It is registered so
	   that what is worked out from it (the line's colour, the card's edge) fades. */
	@property --hot {
		syntax: '<number>';
		inherits: true;
		initial-value: 0;
	}

	/* ── The colours: what belongs to whom ──────────────── */
	.team {
		--tone: var(--c-accent);
		--tone-ink: var(--c-label);
		--tone-soft: var(--c-tint);
		--ring: var(--g-accent);
	}

	.member--warm {
		--tone: var(--c-stroke);
		--tone-ink: var(--c-display);
		--tone-soft: var(--c-card-warm);
		--ring: var(--g-bar);
	}

	/* ── Shared pieces ──────────────────────────────────── */

	/* A round photo frame: a thin ring in the card's colour, a white gap, then the photo; until
	   there is one, the person's initials. */
	.photo {
		display: grid;
		flex: none;
		padding: var(--ring-w, 3px);
		border-radius: 50%;
		background: var(--ring);
	}

	.photo__in {
		display: grid;
		place-items: center;
		aspect-ratio: 1;
		border: var(--gap-w, 5px) solid var(--c-surface);
		border-radius: 50%;
		background: var(--c-panel);
		color: var(--tone-ink);
		font-size: var(--initials, 1.375rem);
		font-weight: 500;
		letter-spacing: 0.04em;
		line-height: 1;
	}

	/* The number and the address. */
	.ways {
		display: grid;
		gap: 0.5rem;
		font-variant-numeric: tabular-nums;
	}

	.ways a {
		display: flex;
		align-items: center;
		gap: 0.625rem;
		color: var(--c-ink);
		line-height: 1.3;
		transition: color 0.15s ease-in-out;
	}

	.ways a:hover {
		color: var(--c-accent);
		text-decoration: underline;
		text-underline-offset: 0.22em;
	}

	.ways :global(.icon) {
		flex: none;
		width: 1.05em;
		height: 1.05em;
		color: var(--tone-ink);
	}

	.ways__text {
		min-width: 0;
		overflow-wrap: anywhere;
	}

	/* A number and an address still to come. */
	.pending {
		color: var(--c-text);
		font-size: var(--fs-small);
		line-height: 1.4;
	}

	/* ── The general manager ────────────────────────────── */
	.lead {
		display: grid;
		justify-items: center;
		max-width: 24rem;
		margin-inline: auto;
		text-align: center;
	}

	.lead__photo {
		--ring-w: 4px;
		--gap-w: 7px;
		--initials: 2.75rem;
		width: min(13rem, 56vw);
	}

	.lead__plate {
		position: relative;
		z-index: 1;
		width: 100%;
		margin-top: -1.75rem;
		padding: 0.9rem 1.75rem 1rem;
		border-radius: 1rem;
		background: var(--c-accent) var(--g-accent-deep);
	}

	.lead__plate h3 {
		color: var(--c-on-accent);
		font-size: 1.25rem;
		font-weight: 600;
		letter-spacing: -0.005em;
		line-height: 1.25;
	}

	.lead__plate p {
		margin-top: 0.2rem;
		color: var(--c-on-dark);
		font-size: var(--fs-small);
	}

	/* The box under the plate: it starts behind the plate. */
	.lead__box {
		display: grid;
		justify-items: center;
		width: 86%;
		margin-top: -0.75rem;
		padding: 1.5rem 1.25rem 1rem;
		border: 1px solid var(--c-card-line);
		border-top: 0;
		border-radius: 0 0 1rem 1rem;
		background: var(--c-surface);
	}

	/* ── The seven ──────────────────────────────────────── */
	.team__members {
		display: grid;
		grid-template-columns: minmax(0, 1fr);
		gap: 1.25rem;
		margin-top: 2.5rem;
	}

	/* A card: on phones the photo above the text, on tablets beside it. */
	.member {
		position: relative;
		display: flex;
		flex-direction: column;
		align-items: flex-start;
		gap: 1rem;
		padding: 1.25rem;
		border: 1px solid color-mix(in srgb, var(--tone) calc(var(--hot) * 45%), var(--c-card-line));
		border-radius: 1.25rem;
		background: var(--c-surface);
		box-shadow:
			0 0.875rem 2rem color-mix(in srgb, var(--c-accent) calc(var(--hot) * 9%), transparent),
			var(--shadow-soft);
		transition: --hot 0.35s ease-out;
	}

	.member:focus-within {
		--hot: 1;
	}

	@media (hover: hover) {
		.member:hover {
			--hot: 1;
		}
	}

	.member__photo {
		--initials: 1.25rem;
		width: 5.5rem;
	}

	.member__body {
		display: grid;
		gap: 0.875rem;
		width: 100%;
		min-width: 0;
	}

	/* The name and the role, and the icon of the trade on the outer side. */
	.member__head {
		display: flex;
		align-items: flex-start;
		gap: 0.875rem;
	}

	.member__who {
		flex: 1;
		min-width: 0;
	}

	.member h3 {
		font-size: 1.125rem;
		font-weight: 600;
		letter-spacing: -0.005em;
		line-height: 1.25;
	}

	.member__role {
		margin-top: 0.2rem;
		font-size: var(--fs-small);
		line-height: 1.35;
	}

	.member__icon {
		display: grid;
		flex: none;
		place-items: center;
		width: 2.5rem;
		height: 2.5rem;
		border-radius: 0.75rem;
		background: var(--tone-soft);
		color: var(--tone-ink);
	}

	.member__icon :global(.icon) {
		width: 1.375rem;
		height: auto;
	}

	.member .ways,
	.member .pending {
		padding-top: 0.875rem;
		border-top: 1px solid var(--c-line);
	}

	.team__orbits,
	.member__link {
		display: none;
	}

	/* Small screens: each card comes up as it is scrolled to. */
	@keyframes member-rise {
		from {
			opacity: 0;
			transform: translateY(1.5rem);
		}
	}

	@media (prefers-reduced-motion: no-preference) {
		@supports (animation-timeline: view()) {
			.member {
				animation: member-rise linear both;
				animation-timeline: view();
				animation-range: entry 0% cover 22%;
			}
		}
	}

	@media (min-width: 44em) {
		.team__members {
			grid-template-columns: repeat(2, minmax(0, 1fr));
			gap: 1.5rem;
		}

		.member {
			flex-direction: row;
			align-items: center;
			gap: 1.25rem;
		}

		.member__photo {
			width: 6rem;
		}
	}

	/* ── Large screens: the director's diagram ──────────── */
	@media (min-width: 80em) {
		/* The stage keeps about the picture's proportions; --u is one of its px. */
		.team__stage {
			position: relative;
			container-type: inline-size;
			aspect-ratio: 1536 / 1100;
		}

		.team__stage > *,
		.team__members > * {
			--u: calc(100cqw / 1536);
		}

		/* Two hairline orbits round the general manager; the lines land on the inner one. */
		.team__orbits {
			display: block;
			position: absolute;
			inset: 0;
			width: 100%;
			height: 100%;
			overflow: visible;
		}

		.orbit {
			fill: none;
			stroke: var(--c-line-strong);
			stroke-width: 1;
			vector-effect: non-scaling-stroke;
		}

		.orbit--outer {
			stroke: var(--c-tile-strong);
			stroke-dasharray: 2 7;
			stroke-linecap: round;
		}

		/* The general manager: his photo in the middle of the orbits, the plate across its foot,
		   the box of his number and address under it. */
		.lead {
			position: absolute;
			top: calc((470 - 150) * var(--u));
			left: calc((765 - 180) * var(--u));
			z-index: 2;
			width: calc(360 * var(--u));
			max-width: none;
		}

		.lead__photo {
			--ring-w: calc(4 * var(--u));
			--gap-w: calc(9 * var(--u));
			--initials: calc(62 * var(--u));
			width: calc(300 * var(--u));
		}

		.lead__plate {
			margin-top: calc(-42 * var(--u));
			padding: calc(16 * var(--u)) calc(24 * var(--u)) calc(18 * var(--u));
			border-radius: calc(18 * var(--u));
		}

		.lead__plate h3 {
			font-size: max(1.125rem, 24 * var(--u));
		}

		.lead__plate p {
			margin-top: calc(3 * var(--u));
			font-size: max(0.9rem, 16 * var(--u));
		}

		.lead__box {
			width: calc(296 * var(--u));
			margin-top: calc(-16 * var(--u));
			padding: calc(32 * var(--u)) calc(22 * var(--u)) calc(16 * var(--u));
			border-radius: 0 0 calc(18 * var(--u)) calc(18 * var(--u));
		}

		.lead__box .ways,
		.lead__box .pending {
			font-size: max(0.9rem, 16 * var(--u));
		}

		/* The seven: each is placed by its corner, at least as tall as in the picture, and grows
		   downwards if a line wraps. --pad is the text's margin on the photo's side. */
		.team__members {
			display: block;
			margin: 0;
		}

		.member {
			position: absolute;
			top: calc(var(--y) * var(--u));
			left: calc(var(--x) * var(--u));
			z-index: 1;
			width: calc(var(--w) * var(--u));
			min-height: calc(var(--h) * var(--u));
			padding: calc(24 * var(--u)) calc(var(--pad) * var(--u)) calc(24 * var(--u)) calc(26 * var(--u));
			border-radius: calc(26 * var(--u));
		}

		.member--right {
			padding-right: calc(26 * var(--u));
			padding-left: calc(var(--pad) * var(--u));
		}

		.member__photo {
			--ring-w: calc(3 * var(--u));
			--gap-w: calc(6 * var(--u));
			--initials: calc(32 * var(--u));
			position: absolute;
			top: 50%;
			right: calc((var(--pin) - 80) * var(--u));
			width: calc(160 * var(--u));
			translate: 0 -50%;
		}

		.member--right .member__photo {
			right: auto;
			left: calc((var(--pin) - 80) * var(--u));
		}

		.member__body {
			gap: calc(14 * var(--u));
		}

		.member__head {
			gap: calc(16 * var(--u));
		}

		/* On the cards on the left, the icon is on the outer side too. */
		.member--left .member__icon {
			order: -1;
		}

		.member h3 {
			font-size: max(1.0625rem, 20 * var(--u));
		}

		.member__role {
			margin-top: calc(3 * var(--u));
			font-size: max(0.9rem, 15.5 * var(--u));
		}

		.member__icon {
			width: calc(42 * var(--u));
			height: calc(42 * var(--u));
			border-radius: calc(12 * var(--u));
		}

		.member__icon :global(.icon) {
			width: calc(23 * var(--u));
		}

		.member .ways,
		.member .pending {
			gap: calc(9 * var(--u));
			padding-top: calc(14 * var(--u));
			font-size: max(0.95rem, 16 * var(--u));
		}

		/* A card's line: from its photo's ring to the orbit (or to the box), where it ends on a
		   point. It is quiet until the card is pointed at, then takes the card's colour. */
		.member__link {
			--line: color-mix(in srgb, var(--tone) calc(40% + var(--hot) * 60%), var(--c-line-strong));
			display: block;
			position: absolute;
			top: 50%;
			left: calc(100% - var(--pin) * var(--u));
			z-index: -1;
			width: calc((80 + var(--len)) * var(--u));
			height: calc(13 * var(--u));
			margin-top: calc(-6.5 * var(--u));
			background:
				radial-gradient(circle closest-side, var(--line) 52%, var(--c-bg) 58% 96%, transparent) 100% 50% /
					calc(13 * var(--u)) 100% no-repeat,
				linear-gradient(var(--line), var(--line)) 0 50% / calc(100% - 6 * var(--u)) max(1.5px, 2 * var(--u)) no-repeat;
			transform-origin: 0 50%;
			rotate: var(--angle);
			pointer-events: none;
		}

		.member--right .member__link {
			left: calc(var(--pin) * var(--u));
		}

		/* As the page opens: the general manager appears, then the cards come out one after
		   the other, each from the side of the middle. */
		@keyframes lead-in {
			from {
				opacity: 0;
				transform: translateY(calc(14 * var(--u)));
			}
		}

		@keyframes orbits-in {
			from {
				opacity: 0;
			}
		}

		@keyframes member-out {
			from {
				opacity: 0;
				transform: translate(var(--from-x, 0), var(--from-y, 0));
			}
		}

		@media (prefers-reduced-motion: no-preference) {
			.lead {
				animation: lead-in 0.7s var(--ease) 0.05s both;
			}

			.team__orbits {
				animation: orbits-in 1s ease-out 0.2s both;
			}

			.member {
				--from-x: calc(24 * var(--u));
				animation: member-out 0.6s var(--ease) calc(0.3s + var(--i) * 0.07s) both;
				animation-timeline: auto;
			}

			.member--right {
				--from-x: calc(-24 * var(--u));
			}

			.member:first-child {
				--from-x: 0;
				--from-y: calc(20 * var(--u));
			}
