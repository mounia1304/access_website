---
import { Image } from 'astro:assets';
import Title from './Title.astro';
import { partners as logos } from '../data/references';
import { useTranslations } from '../i18n';

const t = useTranslations();
const { partners } = t;
---

<section class="section partners" id="partenaires">
	<div class="container partners__inner">
		<header class="section-head">
			<p class="eyebrow">{partners.eyebrow}</p>
			<Title parts={partners.title} />
		</header>

		<ul class="partners__list">
			{
				logos.map((logo) => (
					<li>
						<Image src={logo.image} alt={logo.name} width={240} loading="lazy" />
					</li>
				))
			}
		</ul>
	</div>
</section>

<style>
	/* Follows the client logos directly. */
	.partners {
		padding-top: 0;
	}

	.partners__inner {
		display: grid;
		gap: 2rem;
	}

	.partners .section-head {
		margin-bottom: 0;
	}

	.partners__list {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 12.5rem));
		gap: 0.75rem;
	}

	/* White tiles with a hairline. */
	.partners__list li {
		position: relative;
		aspect-ratio: 5 / 4;
		border: 1px solid var(--c-line-strong);
		border-radius: var(--r-md);
		background: var(--c-surface);
	}

	.partners__list :global(img) {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		padding: 14% 18%;
		object-fit: contain;
	}

	@media (min-width: 48em) {
		.partners__inner {
			grid-template-columns: minmax(0, 1fr) auto;
			column-gap: clamp(2rem, 5vw, 5rem);
			align-items: center;
		}
	}
</style>
