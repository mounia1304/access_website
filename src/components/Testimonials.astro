---
// Fifth screen: the five testimonials of the current site. It has no mockup; the client asked
// for a design that looks made by hand, and creative. The idea comes from the trade:
//
// - The testimonials are a pile of sheets, like papers on a customs desk. The top one is read;
//   the next ones show under it. Choosing another one slides the top sheet away and brings
//   the pile forward.
// - A large French opening quotation mark sits on the pile's corner. It is drawn with the
//   site's own double chevron (the one of the trails between sections): a guillemet is one.
// - A round stamp, like a customs stamp, marks the sheet with its number. It is pressed again
//   each time the sheet changes.
//
// The five names on the left are the tab list (click, arrow keys, Home and End); the arrows
// under the pile and a sideways swipe also change the sheet. Nothing plays by itself.
import Icon from './Icon.astro';
import Title from './Title.astro';
import { site } from '../data/site';
import { useTranslations } from '../i18n';

const t = useTranslations();
const { testimonials } = t;

const number = (index: number) => String(index + 1).padStart(2, '0');
const items = testimonials.items.map((item, index) => ({
	...item,
	number: number(index),
	panelId: `temoignage-${index + 1}`,
	tabId: `temoignage-onglet-${index + 1}`,
	first: index === 0,
	// Place in the pile: 0 is the sheet on top.
	style: `--pos: ${index}`,
}));
const total = number(items.length - 1);
// The words round the stamp, made of the section's label and the company's name.
const stampText = `${testimonials.eyebrow} · ${site.brand} · `;
---

<section class="section testimonials" id="temoignages">
	<div class="testimonials__wrap">
		<!-- A pale round-ended bar behind the pile, and thin strokes, on the slant of the other screens. -->
		<svg class="testimonials__decor" viewBox="0 0 1921 760" aria-hidden="true" focusable="false">
			<defs>
				<linearGradient id="quotes-bar" gradientUnits="userSpaceOnUse" x1="1700" y1="650" x2="2080" y2="116">
					<stop offset="0" stop-opacity="0.95"></stop>
					<stop offset="0.5" stop-opacity="0.7"></stop>
					<stop offset="1" stop-opacity="0"></stop>
				</linearGradient>
			</defs>
			<line x1="1700" y1="650" x2="2080" y2="116" stroke="url(#quotes-bar)" stroke-width="210" stroke-linecap="round"></line>
			<path class="testimonials__strokes" d="M1872 132L1822 202M1846 598L1800 662"></path>
		</svg>

		<div class="quotes" data-quotes>
			<header class="quotes__head">
				<p class="eyebrow eyebrow--lines">{testimonials.eyebrow}</p>
				<Title parts={testimonials.title} stack />
			</header>

			<div class="quotes__stage reveal">
				<div class="quotes__pile" data-quote-pile>
					<span class="quotes__guillemet" aria-hidden="true"></span>

					{
						items.map((item) => (
							<div
								class="quote"
								id={item.panelId}
								role="tabpanel"
								aria-labelledby={item.tabId}
								style={item.style}
								data-quote
								data-current={item.first ? '' : undefined}
								inert={!item.first}
							>
								<figure>
									<blockquote>
										<p>{item.quote}</p>
									</blockquote>
									<figcaption>
										<strong>{item.name}</strong>
										<span>{item.role}</span>
									</figcaption>
								</figure>
							</div>
						))
					}

					<!-- The stamp: the words round it, the sheet's number in the middle. -->
					<svg class="quotes__stamp" viewBox="0 0 120 120" aria-hidden="true" focusable="false" data-quote-stamp>
						<defs>
							<path id="quotes-stamp-ring" d="M60 60m-43.5 0a43.5 43.5 0 1 1 87 0a43.5 43.5 0 1 1 -87 0"></path>
						</defs>
						<circle cx="60" cy="60" r="56.5" class="quotes__stamp-line quotes__stamp-line--thick"></circle>
						<circle cx="60" cy="60" r="51.5" class="quotes__stamp-line"></circle>
						<circle cx="60" cy="60" r="33" class="quotes__stamp-line"></circle>
						<text class="quotes__stamp-words">
							<textPath href="#quotes-stamp-ring" textLength="268" lengthAdjust="spacing">{stampText}</textPath>
						</text>
						<text class="quotes__stamp-number" x="60" y="71" text-anchor="middle" data-quote-number>{items[0].number}</text>
					</svg>
				</div>

				<!-- Under the pile: which sheet is on top, and the arrows. -->
				<div class="quotes__controls">
					<p class="quotes__count" aria-hidden="true">
						<strong data-quote-count>{items[0].number}</strong>
						<span>/ {total}</span>
					</p>
					<span class="quotes__steps" aria-hidden="true">
						{items.map((item) => <i data-quote-step data-current={item.first ? '' : undefined} />)}
					</span>
					<button class="circle" type="button" aria-label={testimonials.prev} data-quote-prev>
						<Icon name="arrow-left" size={18} />
					</button>
					<button class="circle" type="button" aria-label={testimonials.next} data-quote-next>
						<Icon name="arrow-right" size={18} />
					</button>
				</div>
			</div>

			<!-- The five names, down a line: each brings its sheet to the top of the pile. -->
			<div class="quotes__tabs" role="tablist" aria-label={testimonials.tablist} aria-orientation="vertical">
				{
					items.map((item) => (
						<button
							class="quotes__tab"
							type="button"
							role="tab"
							id={item.tabId}
							aria-controls={item.panelId}
							aria-selected={item.first ? 'true' : 'false'}
							tabindex={item.first ? 0 : -1}
							data-quote-tab
						>
							<span class="quotes__tab-number" aria-hidden="true">
								{item.number}
							</span>
							<span class="quotes__who">
								<span class="quotes__name">{item.name}</span>
								<span class="quotes__role">{item.role}</span>
							</span>
						</button>
					))
				}
			</div>
		</div>
	</div>
</section>

<script>
	for (const root of document.querySelectorAll<HTMLElement>('[data-quotes]')) {
		const sheets = [...root.querySelectorAll<HTMLElement>('[data-quote]')];
		const tabs = [...root.querySelectorAll<HTMLButtonElement>('[data-quote-tab]')];
		const steps = [...root.querySelectorAll<HTMLElement>('[data-quote-step]')];
		const count = root.querySelector<HTMLElement>('[data-quote-count]');
		const stamp = root.querySelector<SVGElement>('[data-quote-stamp]');
		const stampNumber = root.querySelector<SVGElement>('[data-quote-number]');
		const pile = root.querySelector<HTMLElement>('[data-quote-pile]');
		const size = sheets.length;
		let current = 0;

		// `way` is 1 when moving on through the pile (the top sheet slides away), -1 when coming
		// back (the sheet slides in from where it left).
		const show = (index: number, way: 1 | -1, focusTab = false) => {
			const next = (index + size) % size;
			if (next === current) return;
			const previous = current;
			current = next;

			sheets.forEach((sheet, i) => {
				sheet.toggleAttribute('data-current', i === current);
				sheet.inert = i !== current;
				sheet.style.setProperty('--pos', String((i - current + size) % size));
				sheet.removeAttribute('data-leaving');
				sheet.removeAttribute('data-entering');
			});
			// Reading a layout value makes the browser take note of the change, so that the same
			// animation can start again.
			void root.offsetWidth;
			if (way > 0) sheets[previous].setAttribute('data-leaving', '');
			else sheets[current].setAttribute('data-entering', '');

			tabs.forEach((tab, i) => {
				tab.setAttribute('aria-selected', String(i === current));
				tab.tabIndex = i === current ? 0 : -1;
			});
			steps.forEach((step, i) => step.toggleAttribute('data-current', i === current));
			const label = String(current + 1).padStart(2, '0');
			if (count) count.textContent = label;
			if (stampNumber) stampNumber.textContent = label;
			// The stamp is pressed again.
			if (stamp) {
				stamp.removeAttribute('data-pressed');
				void stamp.getBoundingClientRect();
				stamp.setAttribute('data-pressed', '');
			}
			if (focusTab) tabs[current].focus();
		};

		for (const sheet of sheets) {
			sheet.addEventListener('animationend', () => {
				sheet.removeAttribute('data-leaving');
				sheet.removeAttribute('data-entering');
			});
		}

		tabs.forEach((tab, index) => {
			tab.addEventListener('click', () => show(index, index > current ? 1 : -1));
			tab.addEventListener('keydown', (event) => {
				if (event.key === 'ArrowDown' || event.key === 'ArrowRight') show(current + 1, 1, true);
				else if (event.key === 'ArrowUp' || event.key === 'ArrowLeft') show(current - 1, -1, true);
				else if (event.key === 'Home') show(0, -1, true);
				else if (event.key === 'End') show(size - 1, 1, true);
				else return;
				event.preventDefault();
			});
		});

		root.querySelector('[data-quote-prev]')?.addEventListener('click', () => show(current - 1, -1));
		root.querySelector('[data-quote-next]')?.addEventListener('click', () => show(current + 1, 1));

		// Swipe left or right on the pile, on touch screens.
		let startX = 0;
		let startY = 0;
		pile?.addEventListener(
			'touchstart',
			(event) => {
				startX = event.touches[0].clientX;
				startY = event.touches[0].clientY;
			},
			{ passive: true },
		);
		pile?.addEventListener(
			'touchend',
			(event) => {
				const dx = event.changedTouches[0].clientX - startX;
				const dy = event.changedTouches[0].clientY - startY;
				if (Math.abs(dx) > 48 && Math.abs(dx) > Math.abs(dy) * 1.5) show(current + (dx < 0 ? 1 : -1), dx < 0 ? 1 : -1);
			},
			{ passive: true },
		);
	}
</script>

<style>
	/*
	 * Sizes are in hundredths of the block's width (cqw), like the third and fourth screens',
	 * so that they read as one design: 1cqw is 19.21px on a block 1921px wide.
	 */
	.testimonials__wrap {
		position: relative;
		container-type: inline-size;
		width: min(100%, 120.0625rem);
		margin-inline: auto;
	}

	/* ── Background ─────────────────────────────────────── */
	.testimonials__decor {
		display: none;
		position: absolute;
		top: 0;
		left: 0;
		z-index: -1;
		width: 100%;
		height: auto;
		overflow: visible;
		pointer-events: none;
	}

	.testimonials__decor stop {
		stop-color: var(--c-tint);
	}

	.testimonials__strokes {
		fill: none;
		stroke: var(--c-stroke);
		stroke-linecap: round;
		stroke-width: 1.6;
	}

	/* ── Layout ─────────────────────────────────────────── */
	.quotes {
		display: grid;
		gap: 2.25rem;
		padding-inline: var(--gutter);
	}

	.quotes__head {
		display: grid;
		justify-items: start;
		gap: clamp(0.75rem, 0.83cqw, 1rem);
	}

	.quotes__head :global(h2) {
		font-size: clamp(2.5rem, 4.1cqw, 4.9rem);
		font-weight: 700;
		letter-spacing: -0.035em;
		line-height: 1;
	}

	/* ── The pile of sheets ─────────────────────────────── */

	/* How a sheet lies: the top one (--pos: 0) leans a little to the left; each of the next two
	   is pushed out by --dx / --dy and turned by --turn more. The rest hide under them. */
	.quotes__stage {
		--lean: -1.4deg;
		--turn: 2.6deg;
		--dx: clamp(0.7rem, 1.3cqw, 1.6rem);
		--dy: clamp(0.5rem, 0.85cqw, 1.05rem);
	}

	.quotes__pile {
		--front: translate(0, 0) rotate(var(--lean));
		--back: translate(calc(2 * var(--dx)), calc(2 * var(--dy))) rotate(calc(var(--lean) + 2 * var(--turn)));
		--away: translate(-42%, -3%) rotate(-10deg);
		position: relative;
		display: grid;
		grid-template-columns: minmax(0, 1fr);
		/* Room for the sheets that show under the top one. */
		padding: 0.5rem calc(2 * var(--dx) + 0.75rem) calc(2 * var(--dy) + 0.5rem) 0.25rem;
		/* Sideways swipes change the sheet; without this, some browsers treat them as "go back". */
		touch-action: pan-y pinch-zoom;
	}

	/* All sheets share one grid cell, so the pile keeps the height of the longest testimonial. */
	.quote {
		--depth: min(var(--pos), 2);
		grid-area: 1 / 1;
		z-index: calc(10 - var(--pos));
		display: grid;
		min-height: clamp(17.5rem, 21.5cqw, 26rem);
		padding: clamp(3.25rem, 4.6cqw, 5.5rem) clamp(1.5rem, 3.3cqw, 4rem) clamp(1.5rem, 2.6cqw, 3.1rem);
		border: 1px solid var(--c-card-line);
		border-radius: clamp(1.375rem, 1.7cqw, 2rem);
		/* The sheets under the top one are a shade paler blue, the deeper the paler. */
		background: color-mix(in srgb, var(--c-tint) calc(var(--depth) * 42%), var(--c-surface));
		/* A thick edge, as on the plates of the screens above: blue on the top sheet. */
		box-shadow:
			0.3rem 0.375rem 0 color-mix(in srgb, var(--c-tile-strong) calc(min(var(--pos), 1) * 100%), var(--c-accent-bright)),
			var(--shadow-pop);
		opacity: clamp(0, 3 - var(--pos), 1);
		transform: translate(calc(var(--depth) * var(--dx)), calc(var(--depth) * var(--dy)))
			rotate(calc(var(--lean) + var(--depth) * var(--turn)));
		transition:
			transform 0.6s var(--ease),
			opacity 0.4s,
			background-color 0.5s,
			box-shadow 0.5s;
	}

	/* Moving on: the top sheet slides away to the left, then goes under the pile. */
	@keyframes quote-leave {
		0% {
			z-index: 20;
			opacity: 1;
			transform: var(--front);
		}

		48% {
			z-index: 20;
			opacity: 1;
			transform: var(--away);
		}

		49% {
			z-index: 0;
			opacity: 1;
			transform: var(--away);
		}

		100% {
			z-index: 0;
			opacity: 0;
			transform: var(--back);
		}
	}

	/* Coming back: the sheet slides in from the left, onto the pile. */
	@keyframes quote-enter {
		0% {
			z-index: 20;
			opacity: 0;
			transform: var(--away);
		}

		100% {
			z-index: 20;
			opacity: 1;
			transform: var(--front);
		}
	}

	.quote[data-leaving] {
		animation: quote-leave 0.75s var(--ease);
	}

	.quote[data-entering] {
		animation: quote-enter 0.55s var(--ease);
	}

	/* Only the top sheet's text shows (and the leaving one's, while it slides away). */
	.quote figure {
		display: grid;
		align-content: space-between;
		gap: clamp(1.5rem, 2.2cqw, 2.75rem);
		opacity: 0;
		transition: opacity 0.2s;
	}

	.quote[data-current] figure {
		opacity: 1;
		transition: opacity 0.35s 0.2s;
	}

	.quote[data-leaving] figure {
		opacity: 1;
	}

	.quote blockquote p {
		max-width: 23em;
		color: var(--c-ink);
		font-size: clamp(1.3125rem, 1.9cqw, 2.3125rem);
		font-weight: 500;
		letter-spacing: -0.02em;
		line-height: 1.3;
		text-wrap: pretty;
	}

	/* The name after a short orange line, the role under it. Room is left on the right for the stamp. */
	.quote figcaption {
		display: grid;
		gap: 0.1rem;
		max-width: calc(100% - clamp(5.75rem, 8.6cqw, 10.25rem));
		padding-left: 1rem;
		border-left: 2px solid var(--c-stroke);
		font-size: var(--fs-small);
		line-height: 1.5;
	}

	.quote figcaption strong {
		font-size: clamp(1rem, 1.02cqw, 1.1875rem);
		font-weight: 600;
	}

	/* The opening guillemet, astride the top edge of the pile: the site's double chevron, in
	   the orange gradient. */
	.quotes__guillemet {
		position: absolute;
		top: calc(clamp(2.6rem, 4cqw, 4.8rem) * -0.32);
		left: clamp(1.5rem, 3.3cqw, 4rem);
		z-index: 30;
		width: calc(clamp(2.6rem, 4cqw, 4.8rem) * 1.4708);
		height: clamp(2.6rem, 4cqw, 4.8rem);
		background: var(--g-bar);
		-webkit-mask: url('../assets/decor/chevron-guillemet.svg') center / 100% 100% no-repeat;
		mask: url('../assets/decor/chevron-guillemet.svg') center / 100% 100% no-repeat;
		transform: rotate(var(--lean));
		pointer-events: none;
	}

	/* The stamp, in one ink, a little askew, on the sheet's lower right corner. */
	.quotes__stamp {
		position: absolute;
		right: calc(2 * var(--dx) + clamp(1rem, 2cqw, 2.4rem));
		bottom: calc(2 * var(--dy) + clamp(0.9rem, 1.5cqw, 1.8rem));
		z-index: 30;
		width: clamp(5.25rem, 7.6cqw, 9.25rem);
		height: auto;
		overflow: visible;
		color: var(--c-display);
		opacity: 0.88;
		rotate: -13deg;
		pointer-events: none;
	}

	.quotes__stamp-line {
		fill: none;
		stroke: currentColor;
		stroke-width: 1.1;
	}

	.quotes__stamp-line--thick {
		stroke-width: 2.6;
	}

	.quotes__stamp-words {
		fill: currentColor;
		font-size: 8.4px;
		font-weight: 700;
		text-transform: uppercase;
	}

	.quotes__stamp-number {
		fill: currentColor;
		font-size: 31px;
		font-weight: 800;
		letter-spacing: -0.03em;
	}

	/* Pressed: it comes down onto the sheet, once, without a bounce. */
	@keyframes stamp-press {
		from {
			opacity: 0;
			scale: 1.32;
		}
	}

	.quotes__stamp[data-pressed] {
		animation: stamp-press 0.4s var(--ease) 0.3s backwards;
	}

	/* ── Under the pile ─────────────────────────────────── */
	.quotes__controls {
		display: flex;
		align-items: center;
		gap: 0.625rem;
		margin-top: clamp(1rem, 1.5cqw, 1.75rem);
		padding-right: calc(2 * var(--dx));
	}

	.quotes__count {
		display: flex;
		align-items: baseline;
		gap: 0.4rem;
		font-size: var(--fs-small);
		font-variant-numeric: tabular-nums;
		white-space: nowrap;
	}

	.quotes__count strong {
		font-size: clamp(1.5rem, 1.9cqw, 2.25rem);
		font-weight: 700;
		letter-spacing: -0.03em;
		line-height: 1;
	}

	/* One short bar per testimonial: the one on top of the pile is longer and orange. */
	.quotes__steps {
		display: flex;
		flex: 1;
		align-items: center;
		gap: 0.375rem;
		margin-inline: 0.75rem;
	}

	.quotes__steps i {
		width: 0.875rem;
		height: 3px;
		border-radius: 2px;
		background: var(--c-tile-strong);
		transition:
			width 0.5s var(--ease),
			background-color 0.4s;
	}

	.quotes__steps i[data-current] {
		width: 2.5rem;
		background: var(--c-stroke);
	}

	/* ── The names ──────────────────────────────────────── */

	/* A line down their left side; the stretch beside the name on top of the pile is orange. */
	.quotes__tabs {
		display: grid;
		align-content: start;
		justify-items: start;
		border-left: 2px solid var(--c-tile-strong);
	}

	.quotes__tab {
		position: relative;
		display: grid;
		grid-template-columns: auto minmax(0, 1fr);
		align-items: baseline;
		gap: 0.9rem;
		padding: 0.6rem 0.75rem 0.6rem 1.25rem;
		border: 0;
		background: none;
		text-align: left;
		cursor: pointer;
	}

	.quotes__tab::before {
		content: '';
		position: absolute;
		top: 0.5rem;
		bottom: 0.5rem;
		left: -2px;
		width: 2px;
		background: var(--c-stroke);
		clip-path: inset(50% 0);
		transition: clip-path 0.45s var(--ease);
	}

	.quotes__tab[aria-selected='true']::before {
		clip-path: inset(0);
	}

	.quotes__tab-number {
		color: var(--c-label-soft);
		font-size: 0.75rem;
		font-weight: 700;
		letter-spacing: 0.12em;
	}

	.quotes__who {
		display: grid;
		gap: 0.05rem;
	}

	.quotes__name {
		color: var(--c-text);
		font-size: clamp(1rem, 1.02cqw, 1.1875rem);
		font-weight: 500;
		line-height: 1.35;
		transition: color 0.3s;
	}

	.quotes__role {
		font-size: 0.8125rem;
		line-height: 1.4;
	}

	.quotes__tab:hover .quotes__name,
	.quotes__tab[aria-selected='true'] .quotes__name {
		color: var(--c-ink);
	}

	.quotes__tab[aria-selected='true'] .quotes__name {
		font-weight: 600;
	}

	/* Small screens: a smaller stamp, so that the name beside it keeps its room. */
	@media (max-width: 47.99em) {
		.quotes__stamp {
			right: calc(2 * var(--dx) + 0.6rem);
			bottom: calc(2 * var(--dy) + 0.75rem);
			width: 4.5rem;
		}

		.quote figcaption {
			max-width: calc(100% - 4.25rem);
		}
	}

	/* ── Large screens: title and names on the left, the pile on the right ── */
	@media (min-width: 64em) {
		.testimonials__decor {
			display: block;
		}

		.quotes {
			grid-template-columns: minmax(0, 0.74fr) minmax(0, 1.26fr);
			grid-template-rows: auto 1fr;
			column-gap: clamp(2.5rem, 5.2cqw, 6.25rem);
			row-gap: clamp(1.75rem, 2.6cqw, 3.125rem);
			padding-inline: 6.25cqw 4.6cqw;
		}

		.quotes__stage {
			grid-area: 1 / 2 / span 2;
		}
	}

	/* Visitors who asked their system for less movement: the sheets change place at once. */
