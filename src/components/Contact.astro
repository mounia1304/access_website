---
import Icon from './Icon.astro';
import RequestForm from './RequestForm.astro';
import Title from './Title.astro';
import { site } from '../data/site';
import { useTranslations } from '../i18n';

interface Props {
	/** Sets the block in line with the inner pages (the contact page), not the homepage's lower blocks.
	    Its two halves then come up as they are scrolled to, like that page's cards. */
	wide?: boolean;
}

const { wide = false } = Astro.props;
const t = useTranslations();
const { contact } = t;
const { form } = contact;

const fields = [
	{ name: 'name', label: form.name, type: 'text', required: true, half: true, autocomplete: 'name' },
	{ name: 'email', label: form.email, type: 'email', required: true, half: true, autocomplete: 'email' },
	{ name: 'phone', label: form.phone, type: 'tel', half: true, autocomplete: 'tel' },
	{ name: 'company', label: form.company, type: 'text', half: true, autocomplete: 'organization' },
	{ name: 'message', label: form.message, type: 'textarea', required: true },
] as const;
---

<section class="section contact glow" id="contact">
	<div class:list={[wide ? 'wrap' : 'container']}>
		<div class:list={['contact__grid', { wrap__in: wide }]}>
		<div class:list={['contact__intro', { reveal: wide }]}>
			<header class="section-head">
				<p class="eyebrow">{contact.eyebrow}</p>
				<Title parts={contact.title} />
			</header>

			<a class="contact__phone" href={site.phone.href}>
				<span class="icon-tile">
					<Icon name="phone-call" size={28} />
				</span>
				{site.phone.display}
			</a>
			<dl class="contact__addresses">
				{
					site.addresses.map((address, index) => (
						<div>
							<dt>
								{contact.address} {index + 1}
							</dt>
							<dd>
								<address>{address}</address>
							</dd>
						</div>
					))
				}
			</dl>
		</div>

		<!-- Demo only for now: the form is wired to e-mail delivery in phase 4. -->
		<RequestForm id="contact" fields={fields} submit={form.submit} class={wide ? 'reveal' : undefined} />
		</div>
	</div>
</section>

<style>
	.contact {
		--glow-x: 66%;
	}

	.contact__grid {
		display: grid;
		gap: 2.5rem;
	}

	.contact .section-head {
		margin-bottom: 2rem;
	}

	.contact__phone {
		display: inline-flex;
		align-items: center;
		gap: 0.85rem;
		color: var(--c-ink);
		font-size: var(--fs-quote);
		letter-spacing: -0.01em;
		line-height: 1.2;
		white-space: nowrap;
		transition: color 0.15s ease-in-out;
	}

	.contact__phone:hover {
		color: var(--c-accent);
	}

	.contact__addresses {
		display: grid;
		gap: 1.5rem;
		max-width: 26rem;
		margin-top: 2rem;
		padding-top: 2rem;
		border-top: 1px solid var(--c-line);
	}

	.contact__addresses dt {
		margin-bottom: 0.25rem;
		color: var(--c-ink);
	}

	@media (min-width: 60em) {
		.contact__grid {
			grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
			column-gap: clamp(2rem, 6vw, 6rem);
			align-items: start;
		}
	}
</style>
