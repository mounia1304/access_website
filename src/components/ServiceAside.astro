---
// The column beside the quote forms: a card that offers help, with the phone number and a link to
// the contact page. As on the current site, the column also listed the four trades and the
// company's two presentations, and it stood beside the service pages and the presentation too;
// the client had all of that removed (2026-10-22): the menu leads to the trades and to the French
// presentation, and the news page's press corner offers the presentations' files.
import Icon from './Icon.astro';
import { site } from '../data/site';
import { route, useTranslations } from '../i18n';

const t = useTranslations();
const { aside } = t.pages;
---

<aside class="aside">
	<div class="aside__help on-accent">
		<h2>{aside.help}</h2>
		<p>{aside.helpText}</p>
		<a class="btn btn--soft" href={site.phone.href}>
			<Icon name="phone-call" size={18} />
			{site.phone.short}
		</a>
		<a class="aside__more" href={route('contact')}>
			{aside.contact}
			<Icon name="arrow-right" size={14} />
		</a>
	</div>
</aside>

<style>
	/* The card keeps its own height, at the top of the column. */
	.aside {
		display: grid;
		align-content: start;
	}

	/* The card that offers help: the footer's blue. */
	.aside__help {
		display: grid;
		justify-items: start;
		gap: 0.875rem;
		padding: 1.75rem 1.5rem;
		border-radius: var(--r-md);
		background: var(--c-accent) var(--g-accent-deep);
	}

	.aside__help h2 {
		font-size: var(--fs-h3);
		font-weight: 700;
		letter-spacing: -0.01em;
	}

	.aside__help .btn {
		margin-top: 0.375rem;
	}

	.aside__more {
		display: inline-flex;
		align-items: center;
		gap: 0.5rem;
		color: var(--c-on-accent);
		font-size: var(--fs-ui);
		font-weight: 500;
	}

	.aside__more:hover {
		text-decoration: underline;
		text-underline-offset: 0.25em;
	}
</style>
