---
import { Image } from 'astro:assets';
import Title from './Title.astro';
import companyPhoto from '../assets/photos/entreprise.jpg';
import ceoPhoto from '../assets/team/mohamed-ezzahraoui.png';
import ceoSignature from '../assets/team/signature-ezzahraoui.png';
import { useTranslations } from '../i18n';

const t = useTranslations();
const { about } = t;
---

<section class="section about" id="entreprise">
	<div class="container about__grid">
		<div class="about__copy">
			<p class="eyebrow">{about.eyebrow}</p>
			<Title parts={about.title} stack />
			<div class="about__text">
				{about.paragraphs.map((paragraph) => <p>{paragraph}</p>)}
			</div>

			<!-- Motto and signature of the managing director. -->
			<div class="about__sign">
				<p class="about__motto">{about.motto}</p>
				<div class="about__ceo">
					<Image class="about__ceo-photo" src={ceoPhoto} alt="" width={128} height={128} loading="lazy" />
					<p class="about__ceo-id">
						<strong>{about.ceo.name}</strong>
						<span>{about.ceo.role}</span>
					</p>
					<Image class="about__ceo-signature" src={ceoSignature} alt="" width={368} loading="lazy" />
				</div>
			</div>
		</div>

		<div class="about__photo reveal">
			<Image
				src={companyPhoto}
				alt={about.imageAlt}
				widths={[360, companyPhoto.width]}
				sizes="(min-width: 60em) 34rem, 90vw"
				quality={76}
				loading="lazy"
			/>
		</div>
	</div>
</section>

<style>
	.about__grid {
		display: grid;
		gap: 2.5rem;
	}

	.about__copy :global(h2) {
		margin-top: 1rem;
	}

	.about__text {
		display: grid;
		gap: 1rem;
		margin-top: 1.5rem;
	}

	.about__sign {
		margin-top: 2.25rem;
		padding-top: 2rem;
		border-top: 1px solid var(--c-line);
	}

	.about__motto {
		color: var(--c-ink);
		font-size: var(--fs-quote);
		letter-spacing: -0.01em;
		line-height: 1.3;
	}

	.about__ceo {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 0.85rem;
		margin-top: 1.5rem;
	}

	.about__ceo :global(.about__ceo-photo) {
		width: 3rem;
		height: 3rem;
		border-radius: 50%;
		object-fit: cover;
	}

	.about__ceo-id {
		display: grid;
		font-size: var(--fs-small);
		line-height: 1.4;
	}

	.about__ceo-id strong {
		font-size: 1rem;
	}

	.about__ceo :global(.about__ceo-signature) {
		width: 10.5rem;
		margin-left: 3.85rem; /* lines up with the name when it wraps below */
		mix-blend-mode: multiply;
	}

	.about__photo {
		aspect-ratio: 5 / 6;
		border-radius: var(--r-lg);
		background: var(--c-chip);
		overflow: hidden;
	}

	.about__photo :global(img) {
		width: 100%;
		height: 100%;
		object-fit: cover;
		object-position: 50% 38%;
	}

	@media (min-width: 36em) {
		.about__ceo :global(.about__ceo-signature) {
			margin-left: auto;
		}

		/* Tablets: the photo runs the full width under the text, in landscape. */
		.about__photo {
			aspect-ratio: 16 / 10;
		}
	}

	@media (min-width: 60em) {
		.about__grid {
			grid-template-columns: minmax(0, 6.6fr) minmax(0, 5fr);
			column-gap: clamp(3rem, 7vw, 7rem);
			align-items: center;
		}

		.about__photo {
			aspect-ratio: 5 / 6;
		}
	}
</style>
