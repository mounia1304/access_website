---
// The way from one page of articles to the next, when there are more than fit on one.
import type { Page } from 'astro';
import Icon from './Icon.astro';
import { useTranslations } from '../i18n';
import { withSlash, type Post } from '../utils/blog';

interface Props {
	page: Page<Post>;
}

const { page } = Astro.props;
const t = useTranslations();
const { blog } = t.pages;
---

{
	page.lastPage > 1 && (
		<nav class="pager" aria-label={blog.page}>
			{page.url.prev ? (
				<a class="btn btn--outline" href={withSlash(page.url.prev)}>
					<Icon name="arrow-left" size={16} />
					{blog.newer}
				</a>
			) : (
				<span />
			)}
			<span class="pager__count">
				{blog.page} {page.currentPage} / {page.lastPage}
			</span>
			{page.url.next ? (
				<a class="btn btn--outline" href={withSlash(page.url.next)}>
					{blog.older}
					<Icon name="arrow-right" size={16} />
				</a>
			) : (
				<span />
			)}
		</nav>
	)
}

<style>
	.pager {
		display: grid;
		grid-template-columns: 1fr auto 1fr;
		align-items: center;
		gap: 1rem;
		margin-top: 3.5rem;
		padding-top: 1.5rem;
		border-top: 1px solid var(--c-line);
	}

	.pager > :last-child {
		justify-self: end;
	}

	.pager__count {
		font-size: var(--fs-label);
		font-variant-numeric: tabular-nums;
	}
</style>
