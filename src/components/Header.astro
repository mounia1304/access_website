---
// Logo, menu and quote button, on a white bar that stays at the top of the screen.
// At the top of a page it floats, a rounded bar of frosted glass a little below the top of the
// screen. Once the page scrolls it docks: it runs the whole width from the very top, solid white,
// so that no text shows above or behind it (the client's request). It keeps its height there.
import { getCollection } from 'astro:content';
import Icon from './Icon.astro';
import Logo from './Logo.astro';
import type { IconName } from './icons';
import { site } from '../data/site';
import { route, useTranslations } from '../i18n';

const t = useTranslations();
const path = Astro.url.pathname;
const isHome = path === route('home');
// Articles live at the root of the site, as on the current one, and categories under /category/:
// both belong to the blog.
const posts = await getCollection('blog');
const inBlog = path.startsWith('/category/') || posts.some((post) => path === `/${post.id}/`);
const within = (href: string) => (path.startsWith(href) || (inBlog && href === route('blog')) ? 'page' : undefined);

// The current site's menu (Accueil, Nos services, E-services, Blog, Notre politique qualité, Contact),
// except that "Blog" became "Actualités", a small menu that holds the Actualités page and the blog
// (the client's decision: there is no room in the bar for one more item), and that "Nos services"
// ends with the company's presentation (its French page; the English one is to be reached through
// FR/EN), which the client moved there from the column of the service pages (2026-10-22). On
// 2026-10-29 the client added "Simulateur" to E-services and "Réglementation" to Actualités (the
// simulator is built since; the regulations page says meanwhile that it is being prepared), and had the language switch
// FR/EN taken out of the bar: it is to come back with the English site (phase 3).
const serviceIcons = Object.fromEntries(t.services.items.map((item) => [item.key, item.icon]));
const eserviceIcons = Object.fromEntries(t.eservices.items.map((item) => [item.key, item.icon]));

const groups = [
	{
		id: 'menu-services',
		label: t.nav.services,
		items: [
			...t.nav.serviceItems.map((item) => ({ ...item, href: route(item.key), icon: serviceIcons[item.key] })),
			{ label: t.nav.presentation, href: route('presentation'), icon: 'buildings' as IconName },
		],
	},
	{
		id: 'menu-eservices',
		label: t.nav.eservices,
		items: [
			...t.nav.eserviceItems.map((item) => ({ ...item, href: route(item.key), icon: eserviceIcons[item.key] })),
			{ label: t.nav.simulateur, href: route('simulateur'), icon: 'percent' as IconName },
		],
	},
	{
		id: 'menu-actualites',
		label: t.nav.news,
		items: [
			{ label: t.nav.news, href: route('actualites'), icon: 'newspaper' as IconName },
			{ label: t.nav.blog, href: route('blog'), icon: 'article' as IconName },
			{ label: t.nav.reglementation, href: route('reglementation'), icon: 'scales' as IconName },
		],
	},
];

const links = [
	{ label: t.nav.quality, href: route('qualite') },
	{ label: t.nav.contact, href: route('contact') },
];

// Practical details shown at the bottom of the mobile menu, as on the current site.
const info: { icon: IconName; label: string; value: string; href?: string }[] = [
	{ icon: 'map-pin', label: t.info.addresses, value: site.location },
	{ icon: 'clock', label: t.info.hours, value: site.hours },
	{ icon: 'envelope', label: t.info.emailUs, value: site.email, href: `mailto:${site.email}` },
	{ icon: 'phone', label: t.info.callUs, value: site.phone.short, href: site.phone.href },
];
---

<header class="header" data-header>
	<div class="header__bar">
		<div class="header__inner">
			<a class="header__brand" href={route('home')} aria-label={`${site.name} — ${t.nav.home}`}>
				<Logo />
			</a>

			<nav class="nav" aria-label={t.common.mainNav}>
				<ul class="nav__list">
					<li class="nav__item">
						<a class="nav__link" href={route('home')} aria-current={isHome ? 'page' : undefined}>
							{t.nav.home}
						</a>
					</li>
					{
						groups.map((group) => (
							<li class="nav__item nav__item--sub">
								<button
									class="nav__link"
									type="button"
									aria-expanded="false"
									aria-controls={group.id}
									data-sub-toggle
									data-current={group.items.some((item) => within(item.href)) ? '' : undefined}
								>
									{group.label}
									<Icon name="caret-down" size={9} class="nav__caret" />
								</button>
								<div class="nav__sub" id={group.id}>
									<ul class="nav__panel">
										{group.items.map((item) => (
											<li>
												<a href={item.href} aria-current={within(item.href)}>
													<span class="icon-tile">
														<Icon name={item.icon} size={22} />
													</span>
													{item.label}
												</a>
											</li>
										))}
									</ul>
								</div>
							</li>
						))
					}
					{
						links.map((link) => (
							<li class="nav__item">
								<a class="nav__link" href={link.href} aria-current={within(link.href)}>
									{link.label}
								</a>
							</li>
						))
					}
				</ul>
			</nav>

			<div class="header__actions">
				<a class="btn btn--accent btn--sm header__cta" href={route('cotation')}>
					{t.common.quoteCta}
					<Icon name="arrow-right" size={14} />
				</a>
				<button class="header__burger" type="button" aria-haspopup="dialog" aria-controls="mobile-menu" data-menu-open>
					{t.common.menu}
					<Icon name="list" size={18} />
				</button>
			</div>
		</div>
	</div>
</header>

<!-- Mobile menu: a full white screen with large links. -->
<dialog class="mmenu" id="mobile-menu" aria-label={t.common.menu}>
	<div class="container container--wide mmenu__head">
		<Logo />
		<button class="mmenu__close" type="button" data-menu-close>
			{t.common.close}
			<Icon name="x" size={16} />
		</button>
	</div>

	<div class="mmenu__body">
		<nav class="container mmenu__nav" aria-label={t.common.mainNav}>
			<a class="mmenu__link" href={route('home')} aria-current={isHome ? 'page' : undefined}>{t.nav.home}</a>
			{
				groups.map((group) => (
					<details class="mmenu__group">
						<summary class="mmenu__link">
							{group.label}
							<Icon name="caret-down" size={18} />
						</summary>
						<ul>
							{group.items.map((item) => (
								<li>
									<a href={item.href} aria-current={within(item.href)}>
										<Icon name={item.icon} size={24} />
										{item.label}
									</a>
								</li>
							))}
						</ul>
					</details>
				))
			}
			{
				links.map((link) => (
					<a class="mmenu__link" href={link.href} aria-current={within(link.href)}>
						{link.label}
					</a>
				))
			}
		</nav>

		<dl class="container mmenu__info">
			{
				info.map((item) => (
					<div>
						<dt>
							<Icon name={item.icon} size={16} />
							{item.label}
						</dt>
						<dd>{item.href ? <a href={item.href}>{item.value}</a> : item.value}</dd>
					</div>
				))
			}
		</dl>
	</div>

	<div class="container mmenu__foot">
		<a class="btn btn--accent" href={route('cotation')}>
			{t.common.quoteCta}
			<Icon name="arrow-right" size={16} />
		</a>
	</div>
</dialog>

<script>
	// Marks the page as scrolled: the bar then docks to the top of the screen (browsers that can
	// tie the change to the scrolling itself do so in CSS).
	const header = document.querySelector<HTMLElement>('[data-header]');
	if (header) {
		const onScroll = () => header.toggleAttribute('data-scrolled', window.scrollY > 48);
		onScroll();
		window.addEventListener('scroll', onScroll, { passive: true });
	}

	// Desktop sub-menus: hover is handled in CSS, this covers keyboard and touch.
	const toggles = [...document.querySelectorAll<HTMLButtonElement>('[data-sub-toggle]')];
	const setOpen = (button: HTMLButtonElement, open: boolean) => {
		button.setAttribute('aria-expanded', String(open));
		button.parentElement?.toggleAttribute('data-open', open);
	};
	for (const button of toggles) {
		button.addEventListener('click', () => {
			const open = button.getAttribute('aria-expanded') !== 'true';
			for (const other of toggles) setOpen(other, other === button && open);
		});
	}
	document.addEventListener('click', (event) => {
		if (!(event.target as Element).closest('.nav__item--sub')) toggles.forEach((b) => setOpen(b, false));
	});
	document.addEventListener('keydown', (event) => {
		if (event.key === 'Escape') toggles.forEach((b) => setOpen(b, false));
	});

	// Mobile menu: closes on a link or on the close button.
	const menu = document.querySelector<HTMLDialogElement>('#mobile-menu');
	if (menu) {
		document.querySelector('[data-menu-open]')?.addEventListener('click', () => menu.showModal());
		for (const el of menu.querySelectorAll('[data-menu-close], a')) {
			el.addEventListener('click', () => menu.close());
		}
	}
</script>

<style>
	/*
	 * At the top of a page the menu floats over it as a rounded bar of frosted glass, as in the
	 * third mockup of the first screen. Once the page scrolls it docks: the client found that text
	 * showed above it and round it, and asked for it to take the whole top of the screen. --dock
	 * goes from 0 (floating) to 1 (docked): the bar loses its gap above, its margins and its
	 * corners, and its glass turns solid white; it keeps its height (on phones it grows to 60px). What it holds keeps its place on the
	 * screen meanwhile (its padding grows as its margins go). The header keeps one height in the
	 * page, so nothing jumps.
	 * Its measures follow the mockup (1717px wide) in hundredths of the screen's width, with floors.
	 */
	@property --dock {
		syntax: '<number>';
		inherits: true;
		initial-value: 0;
	}

	.header {
		--bar-inset: clamp(0.75rem, 3.96vw, 5rem); /* from the sides of the screen */
		--bar-inset-end: calc(var(--bar-inset) * 0.84);
		position: sticky;
		top: 0;
		z-index: 50;
		height: var(--header-h-top);
		pointer-events: none;
		transition: --dock 0.3s var(--ease);
	}

	.header[data-scrolled] {
		--dock: 1;
	}

	/* Tied to the scrolling itself where browsers can, over the first 160px. Both ends are given:
	   without "from", the animation would start from the value [data-scrolled] sets (1). */
	@keyframes header-dock {
		from {
			--dock: 0;
		}

		to {
			--dock: 1;
		}
	}

	@media (prefers-reduced-motion: no-preference) {
		@supports (animation-timeline: scroll()) {
			.header {
				animation: header-dock linear both;
				animation-timeline: scroll(root block);
				animation-range: 0 160px;
			}
		}
	}

	.header__bar {
		position: relative;
		isolation: isolate;
		top: calc(var(--header-gap) * (1 - var(--dock)));
		height: calc(var(--bar-h) - (var(--bar-h) - var(--bar-h-low)) * var(--dock));
		margin: 0 calc(var(--bar-inset-end) * (1 - var(--dock))) 0 calc(var(--bar-inset) * (1 - var(--dock)));
		pointer-events: auto;
	}

	/* The glass is on a layer of its own, so the drop-downs can be frosted too. Docked, it is solid
	   white with a hairline and a soft shadow under it. */
	.header__bar::before {
		content: '';
		position: absolute;
		inset: 0;
		z-index: -1;
		border: 1px solid rgb(255 255 255 / calc(0.2 * (1 - var(--dock))));
		border-radius: calc(clamp(1.125rem, 1.5vw, 1.75rem) * (1 - var(--dock)));
		background: color-mix(in srgb, var(--c-surface) calc(56% + 44% * var(--dock)), transparent);
		-webkit-backdrop-filter: blur(14px);
		backdrop-filter: blur(14px);
		box-shadow: 0 0.5rem 1.5rem transparent;
		transition: box-shadow 0.3s;
	}

	.header[data-scrolled] .header__bar::before {
		box-shadow:
			0 1px 0 var(--c-line),
			var(--shadow-soft);
	}

	.header__inner {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 1rem;
		height: 100%;
		padding-inline:
			calc(clamp(0.85rem, 3.03vw, 3.75rem) + var(--bar-inset) * var(--dock))
			calc(clamp(0.5rem, 1.1vw, 1.375rem) + var(--bar-inset-end) * var(--dock));
	}

	/* The logo is as tall as the mockup's at the top of the page, and gets lower with the bar.
	   Its box keeps its full width meanwhile, so that the menu does not move. */
	.header__brand {
		--logo-max: 2.5rem;
		display: inline-flex;
		flex: none;
		align-items: center;
		width: calc(var(--logo-max) * 2.671);
		height: 100%;
		border-radius: var(--r-xs);
	}

	.header__brand :global(.logo) {
		align-items: center;
		height: 100%;
	}

	.header__brand :global(.logo img) {
		height: min(var(--logo-max), 100% - 0.75rem);
	}

	.header__actions {
		display: flex;
		align-items: center;
		gap: clamp(0.5rem, 2.27vw, 2.75rem);
	}

	.header__cta {
		display: none;
		gap: 0.9em;
		min-height: clamp(2.5rem, 2.91vw, 3.625rem);
		padding-inline: clamp(1.05rem, 1.2vw, 1.75rem);
		font-size: clamp(1.0156rem, 0.95vw, 1.1719rem);
		font-weight: 600;
	}

	.header__burger,
	.mmenu__close {
		display: inline-flex;
		align-items: center;
		gap: 0.5rem;
		min-height: 2.5rem;
		padding: 0.5rem 0.9rem;
		border: 0;
		border-radius: var(--r-pill);
		background: var(--c-chip);
		color: var(--c-ink);
		font-size: var(--fs-label);
		font-weight: 500;
		line-height: 1.25rem;
		cursor: pointer;
	}

	/* ── Desktop navigation ─────────────────────────────── */
	.nav {
		display: none;
		align-self: stretch;
		/* The menu starts at a distance from the logo, which closes up on narrower screens, as do
		   the gaps between its items, so that the menu never reaches the quote button. The client
		   asked for its texts larger (25%) and bold, and "Blog" became "Actualités", a longer word
		   with a caret; FR/EN left the bar on 2026-10-29, which gave room back (89px before the quote
		   button at 1280, 256px at 1920, with the larger text on every laptop). Measure the bar at 1280, 1366, 1420, 1536
		   and 1920 after changing a size or a word in it: at least 15px must stay before the quote button. */
		margin-left: clamp(0.25rem, 22vw - 17.6rem, 6.5rem);
	}

	.nav__list {
		display: flex;
		align-items: stretch;
		gap: clamp(0.625rem, 4.2vw - 3rem, 2.25rem);
		height: 100%;
	}

	.nav__item {
		position: relative;
		display: flex;
		align-items: center;
	}

	.nav__link {
		position: relative;
		display: inline-flex;
		align-items: center;
		gap: 0.3rem;
		padding: 0.5rem 0;
		border: 0;
		background: none;
		color: var(--c-ink);
		font-size: clamp(1.0156rem, 0.95vw, 1.1719rem);
		font-weight: 600; /* the client asked for the menu in bold */
		letter-spacing: 0; /* bold is wider: the bar needs the room */
		line-height: 1.375rem;
		white-space: nowrap;
		cursor: pointer;
		transition: color 0.15s ease-in-out;
	}

	.nav__link:hover,
	.nav__item--sub[data-open] > .nav__link,
	.nav__link:is([aria-current='page'], [data-current]) {
		color: var(--c-accent);
	}

	.nav__link:is([aria-current='page'], [data-current]) {
		font-weight: 800;
	}

	/* A line under the current page. */
	.nav__link:is([aria-current='page'], [data-current])::after {
		content: '';
		position: absolute;
		inset: auto 0 0;
		height: 2px;
		border-radius: 2px;
		background: var(--c-stroke);
	}

	.nav__link :global(.nav__caret) {
		flex: none;
		transition: transform 0.25s var(--ease);
	}

	.nav__item--sub[data-open] :global(.nav__caret) {
		transform: rotate(180deg);
	}

	/* Sub-menu: opens just below the bar. Its top padding bridges the gap for the mouse. */
	.nav__sub {
		position: absolute;
		top: 100%;
		left: 50%;
		padding-top: 0.5rem;
		opacity: 0;
		visibility: hidden;
		transform: translate(-50%, -4px);
		transition:
			opacity 0.15s,
			transform 0.25s var(--ease),
			visibility 0.15s;
	}

	.nav__item--sub[data-open] > .nav__sub {
		opacity: 1;
		visibility: visible;
		transform: translate(-50%, 0);
	}

	@media (hover: hover) {
		.nav__item--sub:hover > .nav__link {
			color: var(--c-accent);
		}

		.nav__item--sub:hover > .nav__sub {
			opacity: 1;
			visibility: visible;
			transform: translate(-50%, 0);
		}

		.nav__item--sub:hover :global(.nav__caret) {
			transform: rotate(180deg);
		}
	}

	/* As wide as its longest label ("Présentation de l’entreprise"), which stays on one line; 19rem at least. */
	.nav__panel {
		width: max-content;
		min-width: 19rem;
		padding: 0.5rem;
		border: 1px solid var(--c-card-line);
		border-radius: var(--r-md);
		background: var(--c-bar);
		-webkit-backdrop-filter: blur(16px);
		backdrop-filter: blur(16px);
		box-shadow: var(--shadow-pop);
	}

	.nav__panel a {
		display: flex;
		align-items: center;
		gap: 0.85rem;
		padding: 0.5rem;
		border-radius: 1rem;
		color: var(--c-ink);
		font-size: var(--fs-ui);
		font-weight: 500;
		white-space: nowrap;
		transition: background-color 0.1s ease-out;
	}

	.nav__panel .icon-tile {
		width: 2.625rem;
		height: 2.625rem;
		border-radius: 0.875rem;
	}

	.nav__panel a:hover {
		background: var(--c-tile);
	}

	.nav__panel a:hover .icon-tile {
		background: var(--c-surface);
	}

	@media (min-width: 40em) {
		.header__cta {
			display: inline-flex;
		}
	}

	/* Logo, then the menu, and the quote button at the far end. */
	@media (min-width: 80em) {
		/* On the narrowest of these screens the logo sits nearer the bar's edge: the menu needs the room. */
		.header__inner {
			display: grid;
			grid-template-columns: auto minmax(0, 1fr) auto;
			padding-left: calc(clamp(1.25rem, min(3.03vw, 9vw - 5.7rem), 3.75rem) + var(--bar-inset) * var(--dock));
		}

		.nav {
			display: block;
		}

		.header__brand {
			--logo-max: clamp(2.75rem, 3.84vw, 4.75rem);
		}

		.header__burger {
			display: none;
		}

	}

	/* ── Mobile menu ─────────────────────────────────────── */
	.mmenu {
		position: fixed;
		inset: 0;
		isolation: isolate;
		flex-direction: column;
		width: 100%;
		max-width: none;
		height: 100dvh;
		max-height: none;
		margin: 0;
		padding: 0;
		border: 0;
		background: var(--c-surface);
		color: var(--c-text);
		overflow: hidden;
		opacity: 0;
		transition:
			opacity 0.2s,
			overlay 0.2s allow-discrete,
			display 0.2s allow-discrete;
	}

	.mmenu[open] {
		display: flex;
		opacity: 1;
	}

	@starting-style {
		.mmenu[open] {
			opacity: 0;
		}
	}

	/* A soft light on the right side of the sheet. */
	.mmenu::before {
		content: '';
		position: absolute;
		inset: 0;
		z-index: -1;
		background: radial-gradient(75% 55% at 110% 55%, var(--c-glow), transparent);
		pointer-events: none;
	}

	.mmenu__head {
		display: flex;
		flex: none;
		align-items: center;
		justify-content: space-between;
		height: var(--header-h-top);
	}

	.mmenu__body {
		flex: 1;
		padding-block: 1.25rem 2rem;
		overflow-y: auto;
		overscroll-behavior: contain;
	}

	.mmenu__nav {
		display: grid;
	}

	.mmenu__link {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 1rem;
		padding-block: 0.7rem;
		color: var(--c-ink);
		font-size: 1.5rem;
		font-weight: 500;
		letter-spacing: -0.01em;
		line-height: 1.25;
		cursor: pointer;
	}

	.mmenu__link[aria-current='page'] {
		color: var(--c-accent);
	}

	.mmenu__group summary {
		list-style: none;
	}

	.mmenu__group summary::-webkit-details-marker {
		display: none;
	}

	.mmenu__group summary :global(.icon) {
		transition: transform 0.25s var(--ease);
	}

	.mmenu__group[open] summary :global(.icon) {
		transform: rotate(180deg);
	}

	.mmenu__group ul {
		display: grid;
		padding-block: 0.25rem 0.75rem;
	}

	.mmenu__group li a {
		display: flex;
		align-items: center;
		gap: 0.75rem;
		padding-block: 0.6rem;
		color: var(--c-ink);
		font-size: 1.0625rem;
	}

	.mmenu__group li :global(.icon) {
		flex: none;
		color: var(--c-accent);
	}

	.mmenu__info {
		display: grid;
		gap: 1rem;
		margin-top: 1.75rem;
		padding-top: 1.75rem;
		border-top: 1px solid var(--c-line);
		font-size: var(--fs-small);
	}

	.mmenu__info dt {
		display: flex;
		align-items: center;
		gap: 0.45rem;
		color: var(--c-ink);
		font-weight: 500;
	}

	.mmenu__info dt :global(.icon) {
		color: var(--c-accent);
