---
// Logo, menu and quote button, on a white bar that stays at the top of the screen.
// The bar is frosted once the page scrolls (the page blurs behind it) and gets a little lower.
import Icon from './Icon.astro';
import LogoSlot from './LogoSlot.astro';
import type { IconName } from './icons';
import { site } from '../data/site';
import { route, useTranslations } from '../i18n';

const t = useTranslations();
const isHome = Astro.url.pathname === route('home');

// Same menu as the current site: Accueil, Nos services, E-services, Blog, Notre politique qualité, Contact.
const serviceIcons = Object.fromEntries(t.services.items.map((item) => [item.key, item.icon]));
const eserviceIcons = Object.fromEntries(t.eservices.items.map((item) => [item.key, item.icon]));

const groups = [
	{
		id: 'menu-services',
		label: t.nav.services,
		items: t.nav.serviceItems.map((item) => ({ ...item, href: route(item.key), icon: serviceIcons[item.key] })),
	},
	{
		id: 'menu-eservices',
		label: t.nav.eservices,
		items: t.nav.eserviceItems.map((item) => ({ ...item, href: route(item.key), icon: eserviceIcons[item.key] })),
	},
];

const links = [
	{ label: t.nav.blog, href: route('blog') },
	{ label: t.nav.quality, href: route('qualite') },
	{ label: t.nav.contact, href: route('contact') },
];

// Practical details shown at the bottom of the mobile menu, as on the current site.
const info: { icon: IconName; label: string; value: string; href?: string }[] = [
	{ icon: 'map-pin', label: t.info.addresses, value: site.location },
	{ icon: 'clock', label: t.info.hours, value: site.hours },
	{ icon: 'envelope', label: t.info.emailUs, value: site.email, href: `mailto:${site.email}` },
	{ icon: 'phone', label: t.info.callUs, value: site.phone.short, href: site.phone.href },
];
---

<header class="header" data-header>
	<div class="header__bar">
		<div class="container container--wide header__inner">
			<a class="header__brand" href={route('home')} aria-label={`${site.name} — ${t.nav.home}`}>
				<LogoSlot />
			</a>

			<nav class="nav" aria-label={t.common.mainNav}>
				<ul class="nav__list">
					<li class="nav__item">
						<a class="nav__link" href={route('home')} aria-current={isHome ? 'page' : undefined}>
							{t.nav.home}
						</a>
					</li>
					{
						groups.map((group) => (
							<li class="nav__item nav__item--sub">
								<button class="nav__link" type="button" aria-expanded="false" aria-controls={group.id} data-sub-toggle>
									{group.label}
									<Icon name="caret-down" size={11} class="nav__caret" />
								</button>
								<div class="nav__sub" id={group.id}>
									<ul class="nav__panel">
										{group.items.map((item) => (
											<li>
												<a href={item.href}>
													<span class="icon-tile">
														<Icon name={item.icon} size={22} />
													</span>
													{item.label}
												</a>
											</li>
										))}
									</ul>
								</div>
							</li>
						))
					}
					{
						links.map((link) => (
							<li class="nav__item">
								<a class="nav__link" href={link.href}>
									{link.label}
								</a>
							</li>
						))
					}
				</ul>
			</nav>

			<div class="header__actions">
				<a class="btn btn--accent btn--sm header__cta" href={route('cotation')}>
					{t.common.quoteCta}
					<Icon name="arrow-right" size={14} />
				</a>
				<button class="header__burger" type="button" aria-haspopup="dialog" aria-controls="mobile-menu" data-menu-open>
					{t.common.menu}
					<Icon name="list" size={18} />
				</button>
			</div>
		</div>
	</div>
</header>

<!-- Mobile menu: a full white screen with large links. -->
<dialog class="mmenu" id="mobile-menu" aria-label={t.common.menu}>
	<div class="container container--wide mmenu__head">
		<LogoSlot />
		<button class="mmenu__close" type="button" data-menu-close>
			{t.common.close}
			<Icon name="x" size={16} />
		</button>
	</div>

	<div class="mmenu__body">
		<nav class="container mmenu__nav" aria-label={t.common.mainNav}>
			<a class="mmenu__link" href={route('home')} aria-current={isHome ? 'page' : undefined}>{t.nav.home}</a>
			{
				groups.map((group) => (
					<details class="mmenu__group">
						<summary class="mmenu__link">
							{group.label}
							<Icon name="caret-down" size={18} />
						</summary>
						<ul>
							{group.items.map((item) => (
								<li>
									<a href={item.href}>
										<Icon name={item.icon} size={24} />
										{item.label}
									</a>
								</li>
							))}
						</ul>
					</details>
				))
			}
			{
				links.map((link) => (
					<a class="mmenu__link" href={link.href}>
						{link.label}
					</a>
				))
			}
		</nav>

		<dl class="container mmenu__info">
			{
				info.map((item) => (
					<div>
						<dt>
							<Icon name={item.icon} size={16} />
							{item.label}
						</dt>
						<dd>{item.href ? <a href={item.href}>{item.value}</a> : item.value}</dd>
					</div>
				))
			}
		</dl>
	</div>

	<div class="container mmenu__foot">
		<a class="btn btn--accent" href={route('cotation')}>
			{t.common.quoteCta}
			<Icon name="arrow-right" size={16} />
		</a>
	</div>
</dialog>

<script>
	// Marks the page as scrolled: the bar then takes its lower height (browsers that can tie
	// the change to the scrolling itself do so in CSS), turns frosted and shows a hairline.
	const header = document.querySelector<HTMLElement>('[data-header]');
	if (header) {
		const onScroll = () => header.toggleAttribute('data-scrolled', window.scrollY > 48);
		onScroll();
		window.addEventListener('scroll', onScroll, { passive: true });
	}

	// Desktop sub-menus: hover is handled in CSS, this covers keyboard and touch.
	const toggles = [...document.querySelectorAll<HTMLButtonElement>('[data-sub-toggle]')];
	const setOpen = (button: HTMLButtonElement, open: boolean) => {
		button.setAttribute('aria-expanded', String(open));
		button.parentElement?.toggleAttribute('data-open', open);
	};
	for (const button of toggles) {
		button.addEventListener('click', () => {
			const open = button.getAttribute('aria-expanded') !== 'true';
			for (const other of toggles) setOpen(other, other === button && open);
		});
	}
	document.addEventListener('click', (event) => {
		if (!(event.target as Element).closest('.nav__item--sub')) toggles.forEach((b) => setOpen(b, false));
	});
	document.addEventListener('keydown', (event) => {
		if (event.key === 'Escape') toggles.forEach((b) => setOpen(b, false));
	});

	// Mobile menu: closes on a link or on the close button.
	const menu = document.querySelector<HTMLDialogElement>('#mobile-menu');
	if (menu) {
		document.querySelector('[data-menu-open]')?.addEventListener('click', () => menu.showModal());
		for (const el of menu.querySelectorAll('[data-menu-close], a')) {
			el.addEventListener('click', () => menu.close());
		}
	}
</script>

<style>
	/*
	 * The header keeps one height in the page (so nothing jumps), and the white bar inside it
	 * is what gets lower: from --header-h-top to --header-h over the first 200px of scrolling.
	 */
	.header {
		position: sticky;
		top: 0;
		z-index: 50;
		height: var(--header-h-top);
		pointer-events: none;
	}

	.header__bar {
		position: relative;
		isolation: isolate;
		height: var(--header-h-top);
		pointer-events: auto;
		transition: height 0.3s var(--ease);
	}

	/* The white is on a layer of its own, so the drop-downs can be frosted too. */
	.header__bar::before {
		content: '';
		position: absolute;
		inset: 0;
		z-index: -1;
		background: var(--c-surface);
		box-shadow: 0 1px 0 transparent;
		transition:
			background-color 0.3s,
			box-shadow 0.3s;
	}

	.header[data-scrolled] .header__bar {
		height: var(--header-h);
	}

	.header[data-scrolled] .header__bar::before {
		background: var(--c-bar);
		-webkit-backdrop-filter: blur(16px);
		backdrop-filter: blur(16px);
		box-shadow: 0 1px 0 var(--c-line);
	}

	@keyframes header-lower {
		to {
			height: var(--header-h);
		}
	}

	@media (prefers-reduced-motion: no-preference) {
		@supports (animation-timeline: scroll()) {
			.header__bar {
				animation: header-lower linear both;
				animation-timeline: scroll(root block);
				animation-range: 0 200px;
			}
		}
	}

	.header__inner {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 1rem;
		height: 100%;
	}

	.header__brand {
		display: inline-flex;
		flex: none;
		border-radius: var(--r-xs);
	}

	.header__actions {
		display: flex;
		align-items: center;
		gap: 0.5rem;
	}

	.header__cta {
		display: none;
		gap: 0.7rem;
		padding-inline: 1.05rem;
	}

	.header__burger,
	.mmenu__close {
		display: inline-flex;
		align-items: center;
		gap: 0.5rem;
		min-height: 2.5rem;
		padding: 0.5rem 0.9rem;
		border: 0;
		border-radius: var(--r-pill);
		background: var(--c-chip);
		color: var(--c-ink);
		font-size: var(--fs-label);
		font-weight: 500;
		line-height: 1.25rem;
		cursor: pointer;
	}

	/* ── Desktop navigation ─────────────────────────────── */
	.nav {
		display: none;
		align-self: stretch;
		/* The menu starts at a set distance from the logo, as in the mockup. */
		margin-left: clamp(1.5rem, 27.7vw - 18.25rem, 12.65rem);
	}

	.nav__list {
		display: flex;
		align-items: stretch;
		gap: clamp(1.5rem, 2.465vw, 2.75rem);
		height: 100%;
	}

	.nav__item {
		position: relative;
		display: flex;
		align-items: center;
	}

	.nav__link {
		position: relative;
		display: inline-flex;
		align-items: center;
		gap: 0.4rem;
		padding: 0.5rem 0;
		border: 0;
		background: none;
		color: var(--c-ink);
		font-size: 0.859375rem;
		font-weight: 500;
		line-height: 1.375rem;
		white-space: nowrap;
		cursor: pointer;
		transition: color 0.15s ease-in-out;
	}

	.nav__link:hover,
	.nav__item--sub[data-open] > .nav__link,
	.nav__link[aria-current='page'] {
		color: var(--c-accent);
	}

	/* A line under the current page. */
	.nav__link[aria-current='page']::after {
		content: '';
		position: absolute;
		inset: auto 0 0;
		height: 2px;
		border-radius: 2px;
		background: currentColor;
	}

	.nav__link :global(.nav__caret) {
		transition: transform 0.25s var(--ease);
	}

	.nav__item--sub[data-open] :global(.nav__caret) {
		transform: rotate(180deg);
	}

	/* Sub-menu: opens just below the bar. Its top padding bridges the gap for the mouse. */
	.nav__sub {
		position: absolute;
		top: 100%;
		left: 50%;
		padding-top: 0.5rem;
		opacity: 0;
		visibility: hidden;
		transform: translate(-50%, -4px);
		transition:
			opacity 0.15s,
			transform 0.25s var(--ease),
			visibility 0.15s;
	}

	.nav__item--sub[data-open] > .nav__sub {
		opacity: 1;
		visibility: visible;
		transform: translate(-50%, 0);
	}

	@media (hover: hover) {
		.nav__item--sub:hover > .nav__link {
			color: var(--c-accent);
		}

		.nav__item--sub:hover > .nav__sub {
			opacity: 1;
			visibility: visible;
			transform: translate(-50%, 0);
		}

		.nav__item--sub:hover :global(.nav__caret) {
			transform: rotate(180deg);
		}
	}

	.nav__panel {
		width: 19rem;
		padding: 0.5rem;
		border: 1px solid var(--c-card-line);
		border-radius: var(--r-md);
		background: var(--c-bar);
		-webkit-backdrop-filter: blur(16px);
		backdrop-filter: blur(16px);
		box-shadow: var(--shadow-pop);
	}

	.nav__panel a {
		display: flex;
		align-items: center;
		gap: 0.85rem;
		padding: 0.5rem;
		border-radius: 1rem;
		color: var(--c-ink);
		font-size: var(--fs-ui);
		font-weight: 500;
		transition: background-color 0.1s ease-out;
	}

	.nav__panel .icon-tile {
		width: 2.625rem;
		height: 2.625rem;
		border-radius: 0.875rem;
	}

	.nav__panel a:hover {
		background: var(--c-tile);
	}

	.nav__panel a:hover .icon-tile {
		background: var(--c-surface);
	}

	@media (min-width: 40em) {
		.header__cta {
			display: inline-flex;
		}
	}

	/* Logo, then the menu, and the quote button at the far end. */
	@media (min-width: 80em) {
		.header__inner {
			display: grid;
			grid-template-columns: auto minmax(0, 1fr) auto;
		}

		.nav {
			display: block;
		}

		.header__burger {
			display: none;
		}
	}

	/* ── Mobile menu ─────────────────────────────────────── */
	.mmenu {
		position: fixed;
		inset: 0;
		isolation: isolate;
		flex-direction: column;
		width: 100%;
		max-width: none;
		height: 100dvh;
		max-height: none;
		margin: 0;
		padding: 0;
		border: 0;
		background: var(--c-surface);
		color: var(--c-text);
		overflow: hidden;
		opacity: 0;
		transition:
			opacity 0.2s,
			overlay 0.2s allow-discrete,
			display 0.2s allow-discrete;
	}

	.mmenu[open] {
		display: flex;
		opacity: 1;
	}

	@starting-style {
		.mmenu[open] {
			opacity: 0;
		}
	}

	/* A soft light on the right side of the sheet. */
	.mmenu::before {
		content: '';
		position: absolute;
		inset: 0;
		z-index: -1;
		background: radial-gradient(75% 55% at 110% 55%, var(--c-glow), transparent);
		pointer-events: none;
	}

	.mmenu__head {
		display: flex;
		flex: none;
		align-items: center;
		justify-content: space-between;
		height: var(--header-h-top);
	}

	.mmenu__body {
		flex: 1;
		padding-block: 1.25rem 2rem;
		overflow-y: auto;
		overscroll-behavior: contain;
	}

	.mmenu__nav {
		display: grid;
	}

	.mmenu__link {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 1rem;
		padding-block: 0.7rem;
		color: var(--c-ink);
		font-size: 1.5rem;
		font-weight: 500;
		letter-spacing: -0.01em;
		line-height: 1.25;
		cursor: pointer;
	}

	.mmenu__link[aria-current='page'] {
		color: var(--c-accent);
	}

	.mmenu__group summary {
		list-style: none;
	}

	.mmenu__group summary::-webkit-details-marker {
		display: none;
	}

	.mmenu__group summary :global(.icon) {
		transition: transform 0.25s var(--ease);
	}

	.mmenu__group[open] summary :global(.icon) {
		transform: rotate(180deg);
	}

	.mmenu__group ul {
		display: grid;
		padding-block: 0.25rem 0.75rem;
	}

	.mmenu__group li a {
		display: flex;
		align-items: center;
		gap: 0.75rem;
		padding-block: 0.6rem;
		color: var(--c-ink);
		font-size: 1.0625rem;
	}

	.mmenu__group li :global(.icon) {
		flex: none;
		color: var(--c-accent);
	}

	.mmenu__info {
		display: grid;
		gap: 1rem;
		margin-top: 1.75rem;
		padding-top: 1.75rem;
		border-top: 1px solid var(--c-line);
		font-size: var(--fs-small);
	}

	.mmenu__info dt {
		display: flex;
		align-items: center;
		gap: 0.45rem;
		color: var(--c-ink);
		font-weight: 500;
	}

	.mmenu__info dt :global(.icon) {
		color: var(--c-accent);
	}

	.mmenu__info dd {
		margin-top: 0.1rem;
		padding-left: 1.45rem;
	}

	.mmenu__foot {
		display: grid;
		flex: none;
		padding-block: 1rem max(1rem, env(safe-area-inset-bottom));
		border-top: 1px solid var(--c-line);
	}

	@media (min-width: 26em) {
		.mmenu__info {
			grid-template-columns: repeat(2, minmax(0, 1fr));
		}
	}
</style>
