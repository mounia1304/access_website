---
// The three commitments that close most inner pages of the current site (security and
// insurance, quick information, support). Each starts with the thin orange stroke of the key
// figures, on a pale panel.
import { useTranslations } from '../i18n';

const t = useTranslations();
const { assurances } = t.pages;
---

<section class="section assurances">
	<div class="wrap">
		<div class="wrap__in">
			<ul class="assurances__list">
				{
					assurances.map((item) => (
						<li>
							<h2>{item.title}</h2>
							<p>{item.text}</p>
						</li>
					))
				}
			</ul>
		</div>
	</div>
</section>

<style>
	.assurances {
		padding-top: 0;
	}

	.assurances__list {
		display: grid;
		gap: 2rem;
		padding: clamp(1.75rem, 1rem + 3vw, 3.5rem);
		border-radius: var(--r-lg);
		background: var(--c-panel);
	}

	.assurances li {
		display: grid;
		align-content: start;
		gap: 0.6rem;
	}

	/* The title starts with the stroke, as the key figures of the homepage do. */
	.assurances h2 {
		display: flex;
		align-items: center;
		font-size: var(--fs-h3);
		font-weight: 700;
		letter-spacing: -0.01em;
		line-height: 1.3;
	}

	.assurances h2::before {
		content: '';
		flex: none;
		width: 2px;
		height: 1.05em;
		margin-inline: 0.32em 0.62em;
		border-radius: 2px;
		background: var(--g-bar);
		rotate: calc(var(--slant) * -1);
	}

	.assurances p {
		line-height: 1.65;
	}

	@media (min-width: 56em) {
		.assurances__list {
			grid-template-columns: repeat(3, minmax(0, 1fr));
			gap: clamp(2rem, 4cqw, 4.5rem);
		}
	}
</style>
